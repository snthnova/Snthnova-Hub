-- ===== HELPER =====
local function toTitleCase(m)
    m = m:lower()
    local n, o, p, q = '', #m, 1, true
    while p <= o do
        local r = m:sub(p,p)
        if r == ' ' then n=n..' '; q=true
        else n=n..(q and r:upper() or r); q=false end
        p=p+1
    end
    return n
end

