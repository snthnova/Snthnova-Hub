local function GenerateInventoryLines(list)
    local lines  = {}
    local groups = {}
    for _, item in ipairs(list) do
        local r = item.Rarity or 'Unknown'
        groups[r] = groups[r] or {}
        table.insert(groups[r], item)
    end
    for _, rarity in ipairs(l) do
        if groups[rarity] then
            local items = groups[rarity]
            table.sort(items, function(x, y) return (x.Value * x.Amount) > (y.Value * y.Amount) end)
            table.insert(lines, rarity)
            for _, item in ipairs(items) do
                local name = toTitleCase(item.ItemName)
                if item.IsChroma then name = name .. ' [CHROMA]' end
                table.insert(lines, string.format('  - %dx %s → %d', item.Amount, name, item.Value * item.Amount))
            end
        end
    end
    return lines
end

