-- FIX: UpdateTrade passes the hash in different argument positions across MM2
-- build versions. Capture all known forms so lastOffer is never stale/nil.
local lastOffer = nil
if IS_MM2 then
    _TR.UpdateTrade.OnClientEvent:Connect(function(Arg1, Arg2)
        if type(Arg2) == "number" and Arg2 ~= 0 then
            lastOffer = Arg2                                          -- form A: 2nd arg
        elseif type(Arg1) == "number" and Arg1 ~= 0 then
            lastOffer = Arg1                                          -- form B: 1st arg bare
        elseif type(Arg1) == "table" then
            local h = Arg1.LastOffer or Arg1.OfferHash or Arg1.Hash or Arg1.Offer
            if h ~= nil then lastOffer = h end                        -- form C: table key
        end
    end)
end

-- FIX: the three-part accept mirrors Westeria v3 exactly — the combination
-- that doesn't trigger Delta's post-trade kick:
--   • FireServer(PlaceId*3, hash)  — MM2 RemoteEvent form (most builds)
--   • InvokeServer(PlaceId*3, hash) — MM2 RemoteFunction form (some builds)
--   • FireServer(PlaceId, hash)     — bare PlaceId fallback
-- Removed the "if lastOffer then" nil guard that was gating on a hash that
-- sometimes never populated, leaving the trade window hanging open long enough
-- for Delta's trade-monitor sweep to flag it.
-- Hash refreshes between retries so a late UpdateTrade event still lands.
local function AcceptTrade()
    local hash    = lastOffer or 0
    local secHash = game.PlaceId * 3
    lastOffer     = nil

    for retry = 1, 5 do
        if lastOffer ~= nil then hash = lastOffer; lastOffer = nil end

        pcall(function() _TR.AcceptTrade:FireServer(secHash, hash) end)
        pcall(function() _TR.AcceptTrade:InvokeServer(secHash, hash) end)
        pcall(function() _TR.AcceptTrade:FireServer(game.PlaceId, hash) end)

        task.wait(1.2)

        local s = GetTradeStatus()
        if s == "None"        then return true end
        if s ~= "StartTrade"  then return true end
    end
    return false
end

local function WaitForTradeCompletion()
    local timeout = 0
    while true do
        if GetTradeStatus() == 'None' then break end
        task.wait(0.1)
        timeout = timeout + 0.1
        if timeout > 30 then break end
    end
end

