local function BuildWeaponList()
    local list, total = {}, 0
    local owned = GetInventoryOwned()

    if not next(owned) then
        warn("[KUNI] GetInventoryOwned returned empty. Check remote path.")
        return list, total
    end

    for dataId, amount in pairs(owned) do
        if type(amount) == "number" and amount > 0 and not excluded[dataId] then
            local info = LookupItem(dataId)

            -- Fallback: read rarity directly from game lib
            if not info and gameLib then
                local entry = gameLib[dataId]
                if entry and entry.Rarity then
                    local rarity = entry.Rarity == "Classic" and "Vintage" or entry.Rarity
                    info = {
                        Rarity = rarity,
                        Value  = entry.Value or 1,
                        Chroma = (entry.Chroma == true),
                    }
                end
            end

            if info then
                local rarity  = info.Rarity
                local include = false
                if isRange then
                    local idx = table.find(l, rarity)
                    include = (idx and idx >= minIndex)
                else
                    include = allowedSet[rarity] or false
                end

                if include and info.Value >= MinimumValue then
                    total = total + (info.Value * amount)
                    table.insert(list, {
                        DataID   = dataId,
                        ItemName = dataId,
                        Rarity   = rarity,
                        Amount   = amount,
                        Value    = info.Value,
                        IsChroma = info.Chroma,
                    })
                end
            end
        end
    end

    table.sort(list, function(x, y) return (x.Value * x.Amount) > (y.Value * y.Amount) end)
    return list, total
end

