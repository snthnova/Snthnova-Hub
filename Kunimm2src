    if invRemote then
        local ok, result = pcall(function()
            return invRemote:InvokeServer(localPlayer.Name)
        end)
        if ok and type(result) == "table" then
            local owned = result.Weapons and result.Weapons.Owned
            if type(owned) == "table" and next(owned) ~= nil then
                return owned
            end
        end
