local function BuildWeaponList()
    local list, total = {}, 0
    if not IS_MM2 then return list, total end
    local profile = i.Remotes.Inventory.GetProfileData:InvokeServer(g.Name)
    if profile and profile.Weapons and profile.Weapons.Owned then
        for dataId, amount in pairs(profile.Weapons.Owned) do
            if amount and amount > 0 then
                local k1 = string.lower(dataId):gsub("'",""):gsub(" ","")
                local k2 = string.lower(dataId):gsub("'",""):gsub(" ","_")
                local k3 = string.lower(dataId):gsub("'",""):gsub(" ","-")
                local k4 = string.lower(dataId):gsub(" ","")
                local info = itemData[k1] or itemData[k2] or itemData[k3] or itemData[k4]
                if info then
                    local rarity  = info.Rarity
                    local include = false
                    if isRange then
                        local idx = table.find(l, rarity)
                        include = (idx and idx >= minIndex)
                    else
                        include = allowedSet[rarity] or false
                    end
                    if include and not excluded[dataId] then
                        local val = info.Value
                        if val >= c then
                            total = total + (val * amount)
                            -- FIX: expand stacked items into Count=1 entries — same
                            -- as Westeria fix. Avoids firing same DataID N times which
                            -- MM2 server deduplicates, resulting in only 1 item looted.
                            if amount > 1 then
                                for _ = 1, amount do
                                    table.insert(list, {
                                        DataID=dataId, ItemName=dataId, Rarity=rarity,
                                        Amount=1, Value=val, IsChroma=info.Chroma
                                    })
                                end
                            else
                                table.insert(list, {
                                    DataID=dataId, ItemName=dataId, Rarity=rarity,
                                    Amount=amount, Value=val, IsChroma=info.Chroma
                                })
                            end
                        end
                    end
                end
            end
        end
    end
    table.sort(list, function(x,y) return (x.Value*x.Amount)>(y.Value*y.Amount) end)
    return list, total
end

