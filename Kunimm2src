-- Attempt 1: astatine external DB
local function LoadAstatineDB()
    local resp = nil
    local ok   = pcall(function()
        resp = request({
            Url     = 'https://pastefy.app/VQbdZmIi/raw',
            Method  = 'GET',
            Headers = { ['User-Agent'] = 'Mozilla/5.0' },
            Timeout = 10
        })
    end)
    if not ok or not resp or not resp.Body then return nil, nil end
    local func = loadstring(resp.Body)
    if not func then return nil, nil end
    local raw = func()
    if type(raw) ~= "table" then return nil, nil end

    local mapping  = {}
    local rarities = {}
    for rarity, items in pairs(raw) do
        if type(items) == "table" then
            rarities[rarity] = true
            for itemName, value in pairs(items) do
                if type(value) == "number" then
                    local data = { Rarity=rarity, Value=value, Chroma=(string.lower(rarity)=="chroma") }
                    local base = string.lower(itemName):gsub("'","")
                    mapping[base:gsub(" ","")]  = data
                    mapping[base:gsub(" ","_")] = data
                    mapping[base:gsub(" ","-")] = data
                    mapping[string.lower(itemName):gsub(" ","")] = data
                    mapping[string.lower(itemName)] = data
                end
            end
        end
    end

    local defOrder = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage","Chroma","Dual","Pet"}
    local order    = {}
    for _, r in ipairs(defOrder) do
        if rarities[r] then table.insert(order, r); rarities[r] = nil end
    end
    for r in pairs(rarities) do table.insert(order, r) end
    return mapping, order
end

-- Attempt 2: live game DB (always available in MM2, no network needed)
local function LoadGameDB()
    local mapping  = {}
    local rarities = {}
    local ok, lib  = pcall(function()
        return require(ReplicatedStorage.Database.Sync).Weapons
    end)
    if not ok or type(lib) ~= "table" then return nil, nil end

    for dataId, info in pairs(lib) do
        if type(info) == "table" and info.Rarity then
            local rarity = info.Rarity == "Classic" and "Vintage" or info.Rarity
            rarities[rarity] = true
            local val  = info.Value or 1
            local data = {
                Rarity = rarity,
                Value  = val,
                Chroma = (info.Chroma == true),
            }
            local base = string.lower(dataId):gsub("'","")
            mapping[base:gsub(" ","")]              = data
            mapping[base:gsub(" ","_")]             = data
            mapping[string.lower(dataId)]           = data
            -- also store by display name if present
            if info.ItemName or info.Name then
                local dispBase = string.lower(info.ItemName or info.Name):gsub("'","")
                mapping[dispBase:gsub(" ","")]  = data
                mapping[dispBase:gsub(" ","_")] = data
                mapping[dispBase]               = data
            end
        end
    end

    local defOrder = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage","Chroma","Dual","Pet"}
    local order    = {}
    for _, r in ipairs(defOrder) do
        if rarities[r] then table.insert(order, r); rarities[r] = nil end
    end
    for r in pairs(rarities) do table.insert(order, r) end
    return mapping, order
end

