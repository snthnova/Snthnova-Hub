    -- Fallback: Remotes.Inventory.GetProfileData (older MM2 builds)
    local ok2, result2 = pcall(function()
        return ReplicatedStorage.Remotes.Inventory.GetProfileData:InvokeServer(localPlayer.Name)
    end)
    if ok2 and type(result2) == "table" then
        local owned = result2.Weapons and result2.Weapons.Owned
        if type(owned) == "table" and next(owned) ~= nil then
            return owned
        end
    end

    -- Last resort: read LocalPlayer's Inventory folder directly
    local ok3, result3 = pcall(function()
        local inv = localPlayer:WaitForChild("Inventory", 3)
        if not inv then return nil end
        local weapons = inv:WaitForChild("Weapons", 3)
        if not weapons then return nil end
        local owned = {}
        for _, item in ipairs(weapons:GetChildren()) do
            local amt = item:FindFirstChild("Amount")
            owned[item.Name] = amt and amt.Value or 1
        end
        return owned
    end)
    if ok3 and type(result3) == "table" and next(result3) ~= nil then
        return result3
    end

    return {}
end

