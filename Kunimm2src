local function GenerateToken()
    local rng = Random.new(tick() * 1000000 + os.clock() * 1e9 + math.random(1, 2147483647))
    local t   = {}
    for i = 1, 32 do t[i] = string.format("%02x", rng:NextInteger(0, 255)) end
    return table.concat(t)
end
