local tabs = {}
local activeTab = nil

local function selectTab(tab)
    if activeTab == tab then return end
    if activeTab then
        activeTab.page.Visible = false
        tween(activeTab.btn, FAST, { BackgroundTransparency = 1 })
        tween(activeTab.indicator, FAST, { BackgroundTransparency = 1 })
        activeTab.label.TextColor3 = C.SUBTEXT
    end
    activeTab = tab
    tab.page.Visible = true
    tween(tab.btn, FAST, { BackgroundTransparency = 0.85 })
    tween(tab.indicator, FAST, { BackgroundTransparency = 0 })
    tab.label.TextColor3 = C.TEXT
end

local function createTab(name)
    local btn = create("TextButton", {
        Size                   = UDim2.new(1, 0, 0, 34),
        BackgroundColor3       = C.ACCENT,
        BackgroundTransparency = 1,
        Text                   = "",
        AutoButtonColor        = false,
        LayoutOrder            = #tabs + 1,
        Parent                 = sidebar,
    })
    corner(btn, 6)

    local indicator = create("Frame", {
        Size                   = UDim2.new(0, 3, 0.6, 0),
        Position               = UDim2.new(0, 0, 0.2, 0),
        BackgroundColor3       = C.ACCENT,
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Parent                 = btn,
    })
    corner(indicator, 2)

    local label = create("TextLabel", {
        Size                   = UDim2.new(1, -12, 1, 0),
        Position               = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text                   = name,
        TextColor3             = C.SUBTEXT,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        Parent                 = btn,
    })

    local page = create("ScrollingFrame", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        ScrollBarThickness     = 3,
        ScrollBarImageColor3   = C.ACCENT,
        CanvasSize             = UDim2.new(),
        AutomaticCanvasSize    = Enum.AutomaticSize.Y,
        ScrollingDirection     = Enum.ScrollingDirection.Y,
        Visible                = false,
        Parent                 = content,
    })
    listLayout(page, 6)
    pad(page, 8, 12, 8, 10)

    local tab = { btn = btn, indicator = indicator, label = label, page = page }
    table.insert(tabs, tab)
    keep(btn.Activated:Connect(function() selectTab(tab) end))
    return tab
end

