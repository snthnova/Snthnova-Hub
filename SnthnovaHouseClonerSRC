-- Dropdown: expands inline. The callback fires only when the user picks an entry.
-- onRemove (optional): each row gets an X button. First tap arms it, second tap within 3s calls onRemove(item).
local function addDropdown(page, text, items, initial, onSelect, onRemove)
    local ROW, HEAD, MAXROWS = 30, 36, 5
    local state = { items = items or {}, selected = nil, open = false }

    local holder = create("Frame", {
        Size             = UDim2.new(1, 0, 0, HEAD),
        BackgroundColor3 = C.CARD,
        ClipsDescendants = true,
        LayoutOrder      = nextOrder(page),
        Parent           = page,
    })
    corner(holder, 8)
    stroke(holder)

    local header = create("TextButton", {
        Size                   = UDim2.new(1, 0, 0, HEAD),
        BackgroundTransparency = 1,
        Text                   = "",
        AutoButtonColor        = false,
        Parent                 = holder,
    })
    create("TextLabel", {
        Size                   = UDim2.new(0.5, -10, 1, 0),
        Position               = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text                   = text,
        TextColor3             = C.SUBTEXT,
        TextSize               = 12,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        Parent                 = header,
    })
    local valueLabel = create("TextLabel", {
        Size                   = UDim2.new(0.5, -30, 1, 0),
        Position               = UDim2.new(0.5, 0, 0, 0),
        BackgroundTransparency = 1,
        Text                   = "--",
        TextColor3             = C.TEXT,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Right,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        Parent                 = header,
    })
    local arrow = create("TextLabel", {
        Size                   = UDim2.new(0, 16, 1, 0),
        Position               = UDim2.new(1, -24, 0, 0),
        BackgroundTransparency = 1,
        Text                   = "▾",
        TextColor3             = C.ACCENT,
        TextSize               = 14,
        Font                   = Enum.Font.GothamBold,
        Parent                 = header,
    })

    local list = create("ScrollingFrame", {
        Size                 = UDim2.new(1, -12, 0, 0),
        Position             = UDim2.new(0, 6, 0, HEAD + 4),
        BackgroundColor3     = C.PANEL,
        BorderSizePixel      = 0,
        ScrollBarThickness   = 3,
        ScrollBarImageColor3 = C.ACCENT,
        CanvasSize           = UDim2.new(),
        AutomaticCanvasSize  = Enum.AutomaticSize.Y,
        ScrollingDirection   = Enum.ScrollingDirection.Y,
        Visible              = false,
        Parent               = holder,
    })
    corner(list, 6)
    listLayout(list, 0)

    local api = {}
    local runSelect = onSelect and guard(text, onSelect) or nil

    local function applySize()
        if state.open and #state.items > 0 then
            local listHeight = math.min(#state.items, MAXROWS) * ROW
            list.Visible = true
            list.Size = UDim2.new(1, -12, 0, listHeight)
            tween(holder, FAST, { Size = UDim2.new(1, 0, 0, HEAD + 4 + listHeight + 6) })
            arrow.Text = "▴"
        else
            state.open = false
            list.Visible = false
            tween(holder, FAST, { Size = UDim2.new(1, 0, 0, HEAD) })
            arrow.Text = "▾"
        end
    end

    local choose

    local function rebuild()
        for _, child in ipairs(list:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for i, item in ipairs(state.items) do
            local isSel = item == state.selected
            local row = create("TextButton", {
                Size                   = UDim2.new(1, 0, 0, ROW),
                BackgroundColor3       = C.ACCENT,
                BackgroundTransparency = isSel and 0.8 or 1,
                Text                   = item,
                TextColor3             = isSel and C.ACCENT or C.TEXT,
                TextSize               = 12,
                Font                   = isSel and Enum.Font.GothamBold or Enum.Font.Gotham,
                TextXAlignment         = Enum.TextXAlignment.Left,
                TextTruncate           = Enum.TextTruncate.AtEnd,
                AutoButtonColor        = false,
                LayoutOrder            = i,
                Parent                 = list,
            })
            pad(row, 0, 0, 10, onRemove and 40 or 10)
            row.Activated:Connect(function() choose(item, false) end)

            if onRemove then
                local armed = false
                local removeBtn = create("TextButton", {
                    Size                   = UDim2.new(0, 24, 0, 22),
                    Position               = UDim2.new(1, 8, 0.5, -11),
                    BackgroundColor3       = C.ERROR,
                    BackgroundTransparency = 0.6,
                    Text                   = "✕",
                    TextColor3             = C.TEXT,
                    TextSize               = 11,
                    Font                   = Enum.Font.GothamBold,
                    AutoButtonColor        = false,
                    ZIndex                 = 2,
                    Parent                 = row,
                })
                corner(removeBtn, 5)
                local runRemove = guard("Delete " .. tostring(item), onRemove)
                removeBtn.Activated:Connect(function()
                    if not armed then
                        armed = true
                        removeBtn.Text = "?"
                        removeBtn.BackgroundTransparency = 0
                        task.delay(3, function()
                            if removeBtn.Parent and armed then
                                armed = false
                                removeBtn.Text = "✕"
                                removeBtn.BackgroundTransparency = 0.6
                            end
                        end)
                    else
                        armed = false
                        runRemove(item)
                    end
                end)
            end
        end
    end

    choose = function(item, silent)
        state.selected = item
        valueLabel.Text = item or "--"
        state.open = false
        rebuild()
        applySize()
        if not silent and runSelect and item ~= nil then
            runSelect(item)
        end
    end

    keep(header.Activated:Connect(function()
        if #state.items == 0 then return end
        state.open = not state.open
        applySize()
    end))

    function api:Get() return state.selected end

    function api:Set(item)
        if item ~= nil and table.find(state.items, item) then
            choose(item, true)
        end
    end

    function api:Refresh(newItems)
        state.items = newItems or {}
        if not (state.selected and table.find(state.items, state.selected)) then
            state.selected = state.items[1]
        end
        valueLabel.Text = state.selected or "--"
        state.open = false
        rebuild()
        applySize()
    end

    api:Refresh(state.items)
    if initial ~= nil then api:Set(initial) end
    return api
end

