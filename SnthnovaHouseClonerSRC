    local valLabel = create("TextLabel", {
        Size                   = UDim2.new(0.4, -10, 0, 16),
        Position               = UDim2.new(0.6, 0, 0, 6),
        BackgroundTransparency = 1,
        Text                   = tostring(value),
        TextColor3             = C.ACCENT,
        TextSize               = 12,
        Font                   = Enum.Font.GothamBold,
        TextXAlignment         = Enum.TextXAlignment.Right,
        Parent                 = card,
    })

    local hit = create("TextButton", {
        Size                   = UDim2.new(1, -20, 0, 24),
        Position               = UDim2.new(0, 10, 0, 26),
        BackgroundTransparency = 1,
        Text                   = "",
        AutoButtonColor        = false,
        Parent                 = card,
    })
    local rail = create("Frame", {
        Size             = UDim2.new(1, 0, 0, 6),
        Position         = UDim2.new(0, 0, 0.5, -3),
        BackgroundColor3 = C.SLIDER_BG,
        Parent           = hit,
    })
    corner(rail, 3)
    local fill = create("Frame", {
        Size             = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = C.ACCENT,
        BorderSizePixel  = 0,
        Parent           = rail,
    })
    corner(fill, 3)
    create("UIGradient", {
        Color  = ColorSequence.new(C.ACCENT, C.ACCENT2),
        Parent = fill,
    })
    local knob = create("Frame", {
        Size             = UDim2.new(0, 14, 0, 14),
        Position         = UDim2.new(0, -7, 0.5, -7),
        BackgroundColor3 = C.WHITE,
        Parent           = rail,
    })
    corner(knob, 7)

    local function render()
        local ratio = (max > min) and ((value - min) / (max - min)) or 0
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, -7, 0.5, -7)
        valLabel.Text = tostring(value)
    end
    render()

    local run = guard(text, callback)

    local function setFromX(x)
        local width = hit.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = math.clamp((x - hit.AbsolutePosition.X) / width, 0, 1)
        local newValue = math.floor(min + (max - min) * ratio + 0.5)
        if newValue ~= value then
            value = newValue
            render()
            run(value)
        end
    end

    local dragging = false
    local function stopDrag()
        if dragging then
            dragging = false
            page.ScrollingEnabled = true
        end
    end

    keep(hit.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        dragging = true
        page.ScrollingEnabled = false
        setFromX(input.Position.X)
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                conn:Disconnect()
                stopDrag()
            end
        end)
    end))

    keep(UserInputService.InputChanged:Connect(function(input)
        if dragging and isMotion(input) then
            setFromX(input.Position.X)
        end
    end))

    local api = {}
    function api:Get() return value end
    return api
end

