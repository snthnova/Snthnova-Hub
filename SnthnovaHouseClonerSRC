addSection(pOthers, "You don't need to find it anymore")

addButton(pOthers, "Sell All Lurebox Furniture", function()
    Notify("Loading", "Attempting to sell all Lurebox furniture...", 4, "loading")
    pcall(setthreadidentity, 7)

    local interior
    for _ = 1, 100 do
        interior = ClientData.get("house_interior")
        if interior and interior.furniture then break end
        task.wait(0.1)
    end
    if not (interior and interior.furniture) then
        Notify("Error", "No house/furniture found. Enter your house first.", 6, "error")
        return
    end
    if interior.player ~= LocalPlayer then
        Notify("Error", "You are not inside your own house.", 6, "error")
        return
    end

    local lureboxKeys, lureKeys = {}, {}
    for k, v in pairs(interior.furniture) do
        local id   = tostring(v.id or ""):lower()
        local db   = FurnitureDB[v.id]
        local name = tostring(db and db.name or ""):lower()
        if id:find("lurebox") or name:find("lurebox") then
            table.insert(lureboxKeys, k)
        elseif id:find("lure") or name:find("lure") then
            table.insert(lureKeys, k)
        end
    end

    local targets = #lureboxKeys > 0 and lureboxKeys or lureKeys
    if #targets == 0 then
        Notify("Error", "No Lurebox furniture found.", 5, "error")
        return
    end

    local sellRemote = RouterClient.get("HousingAPI/SellFurniture")

    local function remaining()
        local left = {}
        local current = ClientData.get("house_interior")
        for _, k in ipairs(targets) do
            if current and current.furniture and current.furniture[k] then
                left[#left + 1] = k
            end
        end
        return left
    end

    sellRemote:FireServer(true, targets, "sell")
    task.wait(0.6)
    local left = remaining()

    if #left > 0 then
        sellRemote:FireServer(false, left, "sell")
        task.wait(0.6)
        left = remaining()
    end

    if #left > 0 then
        for _, k in ipairs(left) do
            sellRemote:FireServer(true, { k }, "sell")
            task.wait(0.25)
            local current = ClientData.get("house_interior")
            if current and current.furniture and current.furniture[k] then
                sellRemote:FireServer(false, { k }, "sell")
                task.wait(0.25)
            end
        end
        left = remaining()
    end

    local sold = #targets - #left
    if sold <= 0 then
        Notify("Error", "No items sold. Possibly protected or server denied.", 6, "error")
    else
        Notify("Success", "Finished! Sold " .. sold .. " lure items.", 6, "success")
    end
end)

