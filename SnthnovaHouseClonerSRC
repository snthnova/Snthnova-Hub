TabOthers:Button({
    Title    = "Sell All Lurebox Furniture",
    Callback = function()
        Notify("Loading", "Attempting to sell all Lurebox furniture...", 4)
        task.spawn(function()
            pcall(function() setthreadidentity(7) end)
            repeat task.wait() until game:IsLoaded()

            local RS  = game:GetService("ReplicatedStorage")
            local LP2 = game:GetService("Players").LocalPlayer
            local RC2, CD2, FDB2

            if not pcall(function()
                RC2 = require(RS.ClientModules.Core.RouterClient.RouterClient)
            end) then
                return Notify("Error", "Failed to require RouterClient", 5)
            end

            if not pcall(function()
                CD2 = require(RS.ClientModules.Core.ClientData)
            end) then
                return Notify("Error", "Failed to require ClientData", 5)
            end

            if not pcall(function()
                FDB2 = require(RS.ClientDB.Housing.FurnitureDB)
            end) then
                return Notify("Error", "Failed to require FurnitureDB", 5)
            end

            local attempts = 0
            while true do
                task.wait(0.1)
                attempts = attempts + 1
                local interior = CD2.get and CD2.get("house_interior")

                if (interior and interior.furniture) or attempts >= 100 then
                    if not (interior and interior.furniture) then
                        return Notify("Error", "No house/furniture found. Enter your house first.", 6)
                    end
                    if interior.player ~= LP2 then
                        return Notify("Error", "You are not inside your own house.", 6)
                    end

                    local lureboxKeys, lureKeys = {}, {}
                    for k, v in pairs(interior.furniture) do
                        local id   = tostring(v.id or ""):lower()
                        local name = (FDB2[v.id] and (FDB2[v.id].name or "") or ""):lower()
                        if id:find("lurebox") or name:find("lurebox") then
                            table.insert(lureboxKeys, k)
                        elseif id:find("lure") or name:find("lure") then
                            table.insert(lureKeys, k)
                        end
                    end

                    local targets = #lureboxKeys > 0 and lureboxKeys or lureKeys

                    if #targets == 0 then
                        return Notify("Error", "No Lurebox furniture found.", 5)
                    end

                    -- Try batch sell
                    local batchOk = false
                    for _, flag in ipairs({ true, false }) do
                        if pcall(function()
                            RC2.get("HousingAPI/SellFurniture"):FireServer(flag, targets, "sell")
                        end) then
                            task.wait(0.5)
                            batchOk = true
                            break
                        end
                    end

                    if batchOk then
                        return Notify("Success", "Successfully sold all lure furniture!", 5)
                    end

                    -- Individual fallback
                    local sold = 0
                    for _, k in ipairs(targets) do
                        pcall(function()
                            RC2.get("HousingAPI/SellFurniture"):FireServer(true, { k }, "sell")
                        end)
                        task.wait(0.25)
                        if CD2.get("house_interior").furniture[k] then
                            pcall(function()
                                RC2.get("HousingAPI/SellFurniture"):FireServer(false, { k }, "sell")
                            end)
                            task.wait(0.25)
                            if not CD2.get("house_interior").furniture[k] then
                                sold = sold + 1
                            end
                        else
                            sold = sold + 1
                        end
                    end

                    if sold <= 0 then
                        Notify("Error", "No items sold. Possibly protected or server denied.", 6)
                    else
                        Notify("Success", "Finished! Sold " .. sold .. " lure items.", 6)
                    end
                    return
                end
            end
        end)
    end,
})

