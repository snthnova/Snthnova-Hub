local function baseName(path)
    return path:match("([^/\\]+)$") or path
end

local function getHouseTypes()
    local types = {}
    for k in pairs(HouseDB) do
        table.insert(types, k)
    end
    table.sort(types)
    return types
end

local function getBuildingType(content)
    local viaPattern = content:match('building_type["%]%s=]*"([^"]+)"')
    if viaPattern then return viaPattern end
    local at = content:find("building_type", 1, true)
    if not at then return nil end
    local comma = content:find(",", at + 15, true)
    if not comma then return nil end
    return content:sub(at + 15, comma - 2)
end

local function getFilesForType(houseType)
    local files = {}
    for _, path in ipairs(listfiles("Savedhouses")) do
        local ok, content = pcall(readfile, path)
        if ok and type(content) == "string" then
            if content ~= "" then
                if getBuildingType(content) == houseType then
                    table.insert(files, path)
                end
            elseif houseType == "micro_2023" then
                table.insert(files, path)
            end
        end
    end
    return files
end

local function currentType()
    return typeDrop:Get() or "micro_2023"
end

local function selectedFilePath()
    local name = fileDrop:Get()
    return name and fileMap[name] or nil
end

local function refreshFiles(preferPath)
    local paths = getFilesForType(currentType())
    fileMap = {}
    local names = {}
    for _, p in ipairs(paths) do
        local n = baseName(p)
        fileMap[n] = p
        table.insert(names, n)
    end
    table.sort(names)
    fileDrop:Refresh(names)
    if preferPath then fileDrop:Set(baseName(preferPath)) end
    return #names
end

