local statState = { count = 0, fCost = 0, tCost = 0, prog = 0 }

------------------------------------------------------------------------
-- Guards
------------------------------------------------------------------------

local function Notify(title, content, duration)
    pcall(function()
        WindUI:Notify({
            Title    = title,
            Content  = content,
            Duration = duration or 3,
        })
    end)
end

local function guard(label, fn)
    return function(...)
        local args = table.pack(...)
        local ok, err = pcall(function()
            return fn(table.unpack(args, 1, args.n))
        end)
        if not ok then
            warn("[Seraphis] " .. label .. ": " .. tostring(err))
            Notify("Error: " .. label, tostring(err), 6)
        end
    end
end

local function build(label, fn)
    local ok, result = pcall(fn)
    if not ok then
        warn("[Seraphis] build failed (" .. label .. "): " .. tostring(result))
        return nil
    end
    return result
end

------------------------------------------------------------------------
-- Element wrappers
------------------------------------------------------------------------

local function addButton(tab, label, desc, fn)
    return build("button " .. label, function()
        return tab:Button({
            Title       = label,
            Desc        = desc,
            Description = desc,
            Callback    = guard(label, fn),
        })
    end)
end

local function addSection(tab, label)
    local made = build("section " .. label, function()
        return tab:Section({ Title = label })
    end)
    if not made then
        build("divider " .. label, function() return tab:Divider() end)
    end
end

local function addToggle(tab, label, default, fn)
    return build("toggle " .. label, function()
        return tab:Toggle({
            Title    = label,
            Value    = default,
            Default  = default,
            Callback = guard(label, function(v)
                if not uiReady then return end
                fn(v)
            end),
        })
    end)
end

local function addSlider(tab, label, min, max, default, fn)
    return build("slider " .. label, function()
        return tab:Slider({
            Title    = label,
            Step     = 1,
            Value    = { Min = min, Max = max, Default = default },
            Min      = min,
            Max      = max,
            Default  = default,
            Rounding = 0,
            Callback = guard(label, function(v)
                if not uiReady then return end
                fn(v)
            end),
        })
    end)
end

local function addInput(tab, label, placeholder, fn)
    return build("input " .. label, function()
        return tab:Input({
            Title       = label,
            Placeholder = placeholder,
            Value       = "",
            Default     = "",
            Finished    = false,
            Callback    = guard(label, fn),
        })
    end)
end

local function listOrEmpty(values)
    if #values == 0 then return { EMPTY_LABEL } end
    return values
end

-- Dropdown callbacks are ignored until the whole UI is built, WindUI fires them at construction.
local function addDropdown(tab, label, values, fn)
    local shown = listOrEmpty(values)
    local element = build("dropdown " .. label, function()
        return tab:Dropdown({
            Title     = label,
            Values    = shown,
            Value     = shown[1],
            Default   = shown[1],
            Multi     = false,
            AllowNone = true,
            Callback  = guard(label, function(val)
                if not uiReady then return end
                if type(val) == "table" then val = val[1] end
                if val == nil or val == EMPTY_LABEL then val = nil end
                fn(val)
            end),
        })
    end)
    local handle = {}
    function handle:SetValues(newValues)
        if not element then return end
        local list = listOrEmpty(newValues)
        pcall(function()
            if element.Refresh then element:Refresh(list)
            elseif element.SetValues then element:SetValues(list) end
        end)
    end
    function handle:Set(value)
        if not element then return end
        local target = value or EMPTY_LABEL
        pcall(function()
            if element.Select then element:Select(target)
            elseif element.Set then element:Set(target) end
        end)
    end
    return handle
end

local function addStats(tab, title, content)
    local element = build("stats", function()
        return tab:Paragraph({ Title = title, Desc = content, Content = content })
    end)
    if not element then
        element = build("stats fallback", function()
            return tab:Button({ Title = title, Desc = content, Description = content, Callback = function() end })
        end)
    end
    local handle = {}
    function handle:Update(newTitle, newContent)
        if not element then return end
        local done = false
        if element.SetTitle then done = pcall(element.SetTitle, element, newTitle) or done end
        if element.SetDesc then done = pcall(element.SetDesc, element, newContent) or done end
        if not done and element.SetContent then done = pcall(element.SetContent, element, newContent) or done end
        if not done and element.Set then
            pcall(element.Set, element, { Title = newTitle, Content = newContent, Desc = newContent })
        end
    end
    return handle
end

------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------

local function getHouseTypes()
    local types = {}
    for k in pairs(HouseDB) do
        table.insert(types, k)
    end
    table.sort(types)
    return types
end

local function getFilesForType(houseType)
    local files = {}
    for _, path in ipairs(listfiles("Savedhouses")) do
        local ok, content = pcall(readfile, path)
        if ok then
            if content ~= "" then
                local at = content:find("building_type")
                if at then
                    local idx   = at + 15
                    local comma = content:find(",", idx)
                    local bt    = content:sub(idx, (comma or 0) - 2)
                    if bt == houseType then
                        table.insert(files, path)
                    end
                end
            elseif houseType == "micro_2023" then
                table.insert(files, path)
            end
        end
    end
    return files
end

local function teleportTo(mode, useTP, target)
    setthreadidentity(2)
    local enter = require(game:GetService("ReplicatedStorage").Fsys).load("InteriorsM").enter
    if mode == "interior" then
        getgenv().teleport = useTP
        enter(target, "", {})
    elseif mode == "house" then
        getgenv().teleport = useTP
        enter("housing", "MainDoor", { house_owner = target })
    end
    setthreadidentity(8)
end

------------------------------------------------------------------------
-- Ownership checks
------------------------------------------------------------------------

local function furniturePlaced(id, props, key)
    if placedCache[key] then return true end
    for _, v in pairs(ClientData.get("house_interior").furniture) do
        if  v.id       == id
        and v.cframe.X == props.cframe.X
        and v.cframe.Y == props.cframe.Y
        and v.cframe.Z == props.cframe.Z
        and v.scale    == props.scale then
            placedCache[key] = true
            return true
        end
    end
    return false
end

local function textureOwned(room, slot, id)
    if id == "tile" then return true end
    for k, tex in pairs(ClientData.get("house_interior").textures) do
        if k == room and tex[slot] == id then return true end
    end
    return false
end

------------------------------------------------------------------------
-- Buy helpers (bounded retry)
------------------------------------------------------------------------

local function buyFurniture(id, props, key)
    for attempt = 1, MAX_RETRIES do
        RouterClient.get("HousingAPI/BuyFurnitures"):InvokeServer({{
            kind       = id,
            properties = props,
        }})
        task.wait(0.05)
        if furniturePlaced(id, props, key) then
            print("[DEBUG] bought furniture: " .. id)
            return true
        end
        warn("retrying furniture: " .. id .. " (" .. attempt .. ")")
    end
    warn("gave up furniture: " .. id)
    return false
end

local function buyTexture(room, slot, id)
    for attempt = 1, MAX_RETRIES do
        RouterClient.get("HousingAPI/BuyTexture"):FireServer(room, slot, id)
        task.wait(0.05)
        if textureOwned(room, slot, id) then
            print("bought texture: " .. id)
            return true
        end
        warn("retrying texture: " .. id .. " (" .. attempt .. ")")
    end
    warn("gave up texture: " .. id)
    return false
end

------------------------------------------------------------------------
-- Post-paste helpers
------------------------------------------------------------------------

local function activateSpecialFurniture()
    for k, v in pairs(ClientData.get("house_interior").furniture) do
        if v.text then
            RouterClient.get("HousingAPI/ActivateFurniture"):InvokeServer(
                LocalPlayer, k, "UseBlock", v.text, LocalPlayer.Character
            )
        elseif v.outfit_name then
            RouterClient.get("AvatarAPI/StartEditingMannequin"):InvokeServer(v.outfit)
            RouterClient.get("HousingAPI/ActivateFurniture"):InvokeServer(
                LocalPlayer, k, "UseBlock",
                { save_outfit = true, outfit_name = "Outfit" },
                LocalPlayer.Character
            )
        end
    end
end

local function applyTexturesAmbianceMusic()
    if loadedHouse.textures and pasteTextures then
        for k, tex in pairs(loadedHouse.textures) do
            if tex.floors and not textureOwned(k, "floors", tex.floors) then
                buyTexture(k, "floors", tex.floors)
            end
            if tex.walls and not textureOwned(k, "walls", tex.walls) then
                buyTexture(k, "walls", tex.walls)
            end
            task.wait()
        end
    end
    if loadedHouse.ambiance then
        RouterClient.get("AmbianceAPI/UpdateAmbiance"):FireServer(loadedHouse.ambiance)
    end
    if loadedHouse.music then
        RouterClient.get("RadioAPI/Play"):FireServer(
            loadedHouse.music.name, loadedHouse.music.id
        )
        if not loadedHouse.music.playing then
            RouterClient.get("RadioAPI/Pause"):InvokeServer()
        end
    end
end

------------------------------------------------------------------------
-- Cost calculator
------------------------------------------------------------------------

local function calcCosts(data)
    local fCount, fCost, tCost = 0, 0, 0
    if type(data.furniture) == "table" then
        for _, v in pairs(data.furniture) do
            fCount = fCount + 1
            if FurnitureDB[v.id] and FurnitureDB[v.id].cost then
                fCost = fCost + FurnitureDB[v.id].cost
            end
        end
    end
    if type(data.textures) == "table" then
        for _, tex in pairs(data.textures) do
            if tex.walls and TexturesDB.walls[tex.walls] then
                tCost = tCost + (TexturesDB.walls[tex.walls].cost or 0)
            end
            if tex.floors and TexturesDB.floors[tex.floors] then
                tCost = tCost + (TexturesDB.floors[tex.floors].cost or 0)
            end
        end
    end
    return fCount, fCost, tCost
end

