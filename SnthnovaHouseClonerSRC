addButton(pCreate, "Create House File", function()
    local name = nameInput:Get() or ""
    name = name:match("^%s*(.-)%s*$")
    name = name:gsub('[\\/:*?"<>|]', "_")
    if name == "" then
        Notify("Error", "Please enter a valid house name", 3, "error")
        return
    end
    if not name:match("%.lua$") then
        if name:find("%.") then
            name = name:split(".")[1]
        end
        name = name .. ".lua"
    end
    if name == ".lua" then
        Notify("Error", "Please enter a valid house name", 3, "error")
        return
    end
    local path = "Savedhouses/" .. name
    if isfile(path) then
        Notify("Error", "That file already exists: " .. name, 4, "error")
        return
    end
    writefile(path, "")
    if table.find(houseTypes, "micro_2023") then typeDrop:Set("micro_2023") end
    refreshFiles(path)
    Notify("Success", "Created house file: " .. name, 3, "success")
end)

