------------------------------------------------------------------------
-- Place logic
------------------------------------------------------------------------

local function placeHouseFast()
    placedCache = {}
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    Notify("Loading", "Anchoring to prevent falling...", 5)
    if hrp then hrp.Anchored = true end

    if not (loadedHouse and loadedHouse.furniture) then
        if hrp then hrp.Anchored = false end
        return Notify("Error", "No house has been saved", 3)
    end

    Notify("Loading", "Pasting furnitures...", 3)

    -- Build filtered table, exclude lures except normal
    local filtered, total = {}, 0
    for k, v in pairs(loadedHouse.furniture) do
        if not v.id:find("lure") or v.id == "lures_2023_normal_lure" then
            filtered[k] = v
            total = total + 1
        end
    end

    local batch, placed = {}, 0

    for k, v in pairs(filtered) do
        local db      = FurnitureDB[v.id]
        local hasData = db ~= nil
        local canBuy  = hasData and not db.off_sale and db.cost
                        and db.cost < ClientData.get_data()[LocalPlayer.Name].money

        if hasData and not canBuy then
            if hrp then hrp.Anchored = false end
            return Notify("Error", "Insufficient funds for furniture: " .. v.id, 3)
        end

        if canBuy or not hasData then
            local props = { colors = v.colors, cframe = v.cframe, scale = v.scale }
            if not furniturePlaced(v.id, props, k) then
                table.insert(batch, { kind = v.id, properties = props })
            end
        end

        placed = placed + 1
        updateStats(0, 0, 0, math.floor(placed / total * 100))
    end

    RouterClient.get("HousingAPI/BuyFurnitures"):InvokeServer(batch)
    activateSpecialFurniture()
    Notify("Loading", "Finished furnitures! Applying walls and floors...", 3)
    applyTexturesAmbianceMusic()
    if hrp then hrp.Anchored = false end
    Notify("Success", "House placed successfully!", 3)
end

local function placeHouseSlow()
    placedCache = {}
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")

    Notify("Loading", "Anchoring to prevent falling...", 5)
    if hrp then hrp.Anchored = true end

    if not (loadedHouse and loadedHouse.furniture) then
        if hrp then hrp.Anchored = false end
        return Notify("Error", "No house has been saved", 3)
    end

    Notify("Loading", "Pasting furnitures...", 3)

    local filtered, total = {}, 0
    for k, v in pairs(loadedHouse.furniture) do
        if v.id ~= "lures_2023_cozy_home_lure" then
            filtered[k] = v
            total = total + 1
        end
    end

    local placed = 0

    for k, v in pairs(filtered) do
        local db      = FurnitureDB[v.id]
        local hasData = db ~= nil
        local canBuy  = hasData and not db.off_sale and db.cost
                        and db.cost < ClientData.get_data()[LocalPlayer.Name].money

        if hasData and not canBuy then
            if hrp then hrp.Anchored = false end
            return Notify("Error", "Insufficient funds for furniture: " .. v.id, 3)
        end

        if canBuy or not hasData then
            local props = { colors = v.colors, cframe = v.cframe, scale = v.scale }
            if not furniturePlaced(v.id, props, k) then
                buyFurniture(v.id, props, k)
            end
        end

        placed = placed + 1
        updateStats(0, 0, 0, math.floor(placed / total * 100))
    end

    activateSpecialFurniture()
    Notify("Loading", "Finished furnitures! Applying walls and floors...", 3)
    applyTexturesAmbianceMusic()
    if hrp then hrp.Anchored = false end
    Notify("Success", "House placed successfully!", 3)
end

local function clearAndPlace(slow)
    setthreadidentity(8)
    if not loadedHouse then
        return Notify("Error", "No house has been saved", 3)
    end
    local interior = ClientData.get("house_interior")
    if interior.player == nil or interior.player ~= LocalPlayer then
        return Notify("Error", "Please enter your house to paste the house", 3)
    end
    Notify("Loading", "Clearing house", 3)
    for k in pairs(interior.furniture) do
        RouterClient.get("HousingAPI/SellFurniture"):FireServer(true, { k }, "sell")
    end
    task.wait(0.1)
    if slow then
        task.spawn(placeHouseSlow)
    else
        task.spawn(placeHouseFast)
    end
end

