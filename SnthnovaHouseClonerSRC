        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
        Parent                 = card,
    })

    local rail = create("Frame", {
        Size             = UDim2.new(0, 38, 0, 20),
        Position         = UDim2.new(1, -48, 0.5, -10),
        BackgroundColor3 = value and C.ACCENT or C.TOGGLE_OFF,
        Parent           = card,
    })
    corner(rail, 10)

    local knob = create("Frame", {
        Size             = UDim2.new(0, 16, 0, 16),
        Position         = value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = C.WHITE,
        Parent           = rail,
    })
    corner(knob, 8)

    local hit = create("TextButton", {
        Size                   = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text                   = "",
        AutoButtonColor        = false,
        Parent                 = card,
    })

    local function render()
        tween(rail, FAST, { BackgroundColor3 = value and C.ACCENT or C.TOGGLE_OFF })
        tween(knob, FAST, {
            Position = value and UDim2.new(1, -18, 0.5, -8) or UDim2.new(0, 2, 0.5, -8),
        })
    end

    local run = guard(text, callback)
    keep(hit.Activated:Connect(function()
        value = not value
        render()
        run(value)
    end))

    local api = {}
    function api:Get() return value end
    function api:Set(v)
        value = v and true or false
        render()
    end
    return api
end

