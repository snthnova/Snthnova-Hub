local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(names, p.Name)
    end
    return names
end

local playerNames = getPlayerNames()
selectedPlayer    = playerNames[1]

local playerDropdown = addDropdown(TabTeleport, "Select Player", playerNames, function(val)
    selectedPlayer = val
end)

local function refreshPlayerList()
    playerNames = getPlayerNames()
    playerDropdown:SetValues(playerNames)
    if selectedPlayer and table.find(playerNames, selectedPlayer) then
        playerDropdown:Set(selectedPlayer)
    elseif #playerNames > 0 then
        selectedPlayer = playerNames[1]
        playerDropdown:Set(selectedPlayer)
    else
        selectedPlayer = nil
    end
end

Players.PlayerAdded:Connect(function()
    task.defer(refreshPlayerList)
end)

Players.PlayerRemoving:Connect(function(p)
    if p.Name == selectedPlayer then selectedPlayer = nil end
    task.defer(refreshPlayerList)
end)

addButton(TabTeleport, "Refresh Players", nil, function()
    refreshPlayerList()
    Notify("Players", "Refreshed: " .. #playerNames .. " players", 3)
end)

addButton(TabTeleport, "Enter House", nil, function()
    if not selectedPlayer or selectedPlayer == "" then
        return Notify("Error", "No player selected", 3)
    end
    local target = Players:FindFirstChild(selectedPlayer)
    if not target then
        return Notify("Error", "Player not found: " .. selectedPlayer, 3)
    end
    teleportTo("house", true, target)
end)

