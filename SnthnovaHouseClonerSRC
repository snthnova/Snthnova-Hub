end

local function snapshotHouse()
    local data = withIdentity(7, function()
        local interior = ClientData.get("house_interior")
        if not interior then return nil end
        local chunk = loadstring("return " .. lib(interior))
        if not chunk then return nil end
        return chunk()
    end)
    if type(data) ~= "table" or data.player == nil then return nil end
    if type(data.furniture) == "table" then
        for _, v in pairs(data.furniture) do
            if type(v) == "table" and v.creator then v.creator = nil end
        end
    end
    return data
end

local function calcCosts(data)
    local fCount, fCost, tCost = 0, 0, 0
    if type(data.furniture) == "table" then
        for _, v in pairs(data.furniture) do
            fCount = fCount + 1
            local db = FurnitureDB[v.id]
            if db and db.cost then fCost = fCost + db.cost end
        end
    end
    if type(data.textures) == "table" then
        for _, tex in pairs(data.textures) do
            local wall  = tex.walls  and TexturesDB.walls  and TexturesDB.walls[tex.walls]
            local floor = tex.floors and TexturesDB.floors and TexturesDB.floors[tex.floors]
            if wall  then tCost = tCost + (wall.cost  or 0) end
            if floor then tCost = tCost + (floor.cost or 0) end
        end
    end
    return fCount, fCost, tCost
end

local function furniturePlaced(id, props, key)
    if placedCache[key] then return true end
    local interior = ClientData.get("house_interior")
    if not (interior and interior.furniture) then return false end
    for _, v in pairs(interior.furniture) do
        if  v.id       == id
        and v.cframe.X == props.cframe.X
        and v.cframe.Y == props.cframe.Y
        and v.cframe.Z == props.cframe.Z
        and v.scale    == props.scale then
            placedCache[key] = true
            return true
        end
    end
    return false
end

local function textureOwned(room, slot, id)
    if id == "tile" then return true end
    local interior = ClientData.get("house_interior")
    if not (interior and interior.textures) then return false end
    for k, tex in pairs(interior.textures) do
        if k == room and tex[slot] == id then return true end
    end
    return false
end

local function buyFurniture(id, props, key)
    for attempt = 1, MAX_RETRIES do
        RouterClient.get("HousingAPI/BuyFurnitures"):InvokeServer({ {
            kind       = id,
            properties = props,
        } })
        task.wait(0.05)
        if furniturePlaced(id, props, key) then
            print("[DEBUG] bought furniture: " .. id)
            return true
        end
        warn("retrying furniture: " .. id .. " (" .. attempt .. ")")
    end
    warn("gave up furniture: " .. id)
    return false
end

local function buyTexture(room, slot, id)
    for attempt = 1, MAX_RETRIES do
        RouterClient.get("HousingAPI/BuyTexture"):FireServer(room, slot, id)
        task.wait(0.05)
        if textureOwned(room, slot, id) then
            print("bought texture: " .. id)
            return true
        end
        warn("retrying texture: " .. id .. " (" .. attempt .. ")")
    end
    warn("gave up texture: " .. id)
    return false
end

local function activateSpecialFurniture()
    local interior = ClientData.get("house_interior")
    if not (interior and interior.furniture) then return end
    for k, v in pairs(interior.furniture) do
        if v.text then
            RouterClient.get("HousingAPI/ActivateFurniture"):InvokeServer(
                LocalPlayer, k, "UseBlock", v.text, LocalPlayer.Character
            )
        elseif v.outfit_name then
            RouterClient.get("AvatarAPI/StartEditingMannequin"):InvokeServer(v.outfit)
            RouterClient.get("HousingAPI/ActivateFurniture"):InvokeServer(
                LocalPlayer, k, "UseBlock",
                { save_outfit = true, outfit_name = "Outfit" },
                LocalPlayer.Character
            )
        end
    end
end

local function applyTexturesAmbianceMusic()
    if type(loadedHouse.textures) == "table" and pasteTextures then
        for k, tex in pairs(loadedHouse.textures) do
            if tex.floors and not textureOwned(k, "floors", tex.floors) then
                buyTexture(k, "floors", tex.floors)
            end
            if tex.walls and not textureOwned(k, "walls", tex.walls) then
                buyTexture(k, "walls", tex.walls)
            end
            task.wait()
        end
    end
    if loadedHouse.ambiance then
        RouterClient.get("AmbianceAPI/UpdateAmbiance"):FireServer(loadedHouse.ambiance)
    end
    if type(loadedHouse.music) == "table" then
        RouterClient.get("RadioAPI/Play"):FireServer(loadedHouse.music.name, loadedHouse.music.id)
        if not loadedHouse.music.playing then
            RouterClient.get("RadioAPI/Pause"):InvokeServer()
        end
    end
end

------------------------------------------------------------------------
-- Placement
------------------------------------------------------------------------

local function runPlacement(slow)
    pcall(setthreadidentity, 8)
    placedCache = {}

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    Notify("Loading", "Anchoring to prevent falling...", 3, "loading")
    if hrp then hrp.Anchored = true end

    local ok, err = pcall(function()
        if not (loadedHouse and type(loadedHouse.furniture) == "table") then
            Notify("Error", "No house has been saved", 3, "error")
            return
        end

        Notify("Loading", "Pasting furnitures...", 3, "loading")

        local list = {}
        for k, v in pairs(loadedHouse.furniture) do
            local id = tostring(v.id)
            local wanted
            if slow then
                wanted = id ~= "lures_2023_cozy_home_lure"
            else
                wanted = (not id:find("lure")) or id == "lures_2023_normal_lure"
            end
            if wanted then list[#list + 1] = { key = k, item = v } end
        end

        local total = #list
        if total == 0 then
            Notify("Error", "Nothing to place in this house", 3, "error")
            return
        end

        local playerData = ClientData.get_data()[LocalPlayer.Name]
        local budget = playerData and playerData.money or 0
        local spent, done, failed = 0, 0, 0
        local batch = {}

        for _, entry in ipairs(list) do
            local v, k = entry.item, entry.key
            local db = FurnitureDB[v.id]
            local purchasable = db ~= nil and db.cost ~= nil and not db.off_sale

            if purchasable then
                local props = { colors = v.colors, cframe = v.cframe, scale = v.scale }
                if not furniturePlaced(v.id, props, k) then
                    local available
                    if slow then
                        local pd = ClientData.get_data()[LocalPlayer.Name]
                        available = pd and pd.money or 0
                    else
                        available = budget - spent
                    end
                    if not (db.cost < available) then
                        Notify("Error", "Insufficient funds for furniture: " .. tostring(v.id), 4, "error")
                        return
                    end
                    if slow then
                        if not buyFurniture(v.id, props, k) then failed = failed + 1 end
                    else
                        spent = spent + db.cost
                        table.insert(batch, { kind = v.id, properties = props })
                    end
                end
            end

            done = done + 1
            setProgress(math.floor(done / total * 100))
        end

        if not slow and #batch > 0 then
            for i = 1, #batch, BATCH_SIZE do
                local chunk = {}
                for j = i, math.min(i + BATCH_SIZE - 1, #batch) do
                    chunk[#chunk + 1] = batch[j]
                end
                RouterClient.get("HousingAPI/BuyFurnitures"):InvokeServer(chunk)
                task.wait(0.1)
            end
            task.wait(0.5)
        end

        activateSpecialFurniture()
        Notify("Loading", "Finished furnitures! Applying walls and floors...", 3, "loading")
        applyTexturesAmbianceMusic()
        setProgress(100)

        if failed > 0 then
            Notify("Done with errors", tostring(failed) .. " furnitures could not be placed", 6, "error")
        else
            Notify("Success", "House placed successfully!", 3, "success")
        end
    end)

    if hrp then hrp.Anchored = false end
    if not ok then
        warn("[Snthnova] placement: " .. tostring(err))
        Notify("Error", tostring(err), 6, "error")
    end
end

local function clearAndPlace(slow)
    if placing then
        Notify("Busy", "A paste is already running", 3, "info")
        return
    end
    pcall(setthreadidentity, 8)
    if not loadedHouse then
        Notify("Error", "No house has been saved", 3, "error")
        return
    end
    local interior = ClientData.get("house_interior")
    if not interior or interior.player == nil or interior.player ~= LocalPlayer then
        Notify("Error", "Please enter your house to paste the house", 3, "error")
        return
    end

    placing = true
    local ok, err = pcall(function()
        Notify("Loading", "Clearing house", 3, "loading")
        for k in pairs(interior.furniture) do
            RouterClient.get("HousingAPI/SellFurniture"):FireServer(true, { k }, "sell")
        end
        for _ = 1, 60 do
            local current = ClientData.get("house_interior")
            if not current or not current.furniture or next(current.furniture) == nil then break end
            task.wait(0.05)
        end
        runPlacement(slow)
    end)
    placing = false
    if not ok then
        warn("[Seraphis] clearAndPlace: " .. tostring(err))
        Notify("Error", tostring(err), 6, "error")
    end
end

