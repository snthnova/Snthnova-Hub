------------------------------------------------------------------------
-- MAIN: stats (single state table, progress never wipes the totals)
------------------------------------------------------------------------

local function statsText()
    return string.format(
        "Furnitures: %d | Furn. Cost: %d | Tex. Cost: %d | Progress: %d%%",
        statState.count, statState.fCost, statState.tCost, statState.prog
    )
end

local stats = addStats(TabMain, "House Stats", statsText())

local function refreshStats()
    stats:Update("House Stats", statsText())
end

local function setTotals(count, fCost, tCost)
    statState.count = count or 0
    statState.fCost = fCost or 0
    statState.tCost = tCost or 0
    statState.prog  = 0
    refreshStats()
end

local function setProgress(prog)
    statState.prog = prog or 0
    refreshStats()
end

