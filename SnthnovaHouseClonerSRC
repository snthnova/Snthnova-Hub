local function Notify(title, content, duration, kind)
    pcall(function()
        if not notifHolder.Parent then return end
        local accent = ACCENTS[kind or "info"] or C.ACCENT2
        duration = duration or 3
        notifCounter = notifCounter + 1

        local card = create("Frame", {
            Size             = UDim2.new(1, 0, 0, 0),
            AutomaticSize    = Enum.AutomaticSize.Y,
            BackgroundColor3 = C.CARD,
            ClipsDescendants = true,
            LayoutOrder      = notifCounter,
            Parent           = notifHolder,
        })
        corner(card, 10)
        stroke(card)

        create("Frame", {
            Size             = UDim2.new(0, 3, 1, 0),
            BackgroundColor3 = accent,
            BorderSizePixel  = 0,
            Parent           = card,
        })

        local body = create("Frame", {
            Size                   = UDim2.new(1, -10, 0, 0),
            Position               = UDim2.new(0, 10, 0, 0),
            AutomaticSize          = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Parent                 = card,
        })
        pad(body, 8, 10, 4, 6)
        listLayout(body, 2)

        create("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 16),
            BackgroundTransparency = 1,
            Text                   = tostring(title or ""),
            TextColor3             = C.TEXT,
            TextSize               = 13,
            Font                   = Enum.Font.GothamBold,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextTruncate           = Enum.TextTruncate.AtEnd,
            LayoutOrder            = 1,
            Parent                 = body,
        })

        create("TextLabel", {
            Size                   = UDim2.new(1, 0, 0, 0),
            AutomaticSize          = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Text                   = tostring(content or ""),
            TextColor3             = C.SUBTEXT,
            TextSize               = 12,
            Font                   = Enum.Font.Gotham,
            TextXAlignment         = Enum.TextXAlignment.Left,
            TextYAlignment         = Enum.TextYAlignment.Top,
            TextWrapped            = true,
            LayoutOrder            = 2,
            Parent                 = body,
        })

        local bar = create("Frame", {
            Size             = UDim2.new(1, 0, 0, 2),
            Position         = UDim2.new(0, 0, 1, -2),
            BackgroundColor3 = accent,
            BorderSizePixel  = 0,
            Parent           = card,
        })
        tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

        local dismiss = create("TextButton", {
            Size                   = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text                   = "",
            ZIndex                 = 10,
            Parent                 = card,
        })
        dismiss.Activated:Connect(function()
            if card.Parent then card:Destroy() end
        end)

        table.insert(notifQueue, card)
        while #notifQueue > 4 do
            local old = table.remove(notifQueue, 1)
            if old and old.Parent then old:Destroy() end
        end

        task.delay(duration, function()
            if card.Parent then card:Destroy() end
        end)
    end)
end

------------------------------------------------------------------------
-- Guard: runs a callback in its own thread, reports errors as a notification
------------------------------------------------------------------------

local function guard(label, fn)
    return function(...)
        local args = table.pack(...)
        task.spawn(function()
            pcall(setthreadidentity, 8)
            local ok, err = pcall(fn, table.unpack(args, 1, args.n))
            if not ok then
                warn("[Snthnova] " .. label .. ": " .. tostring(err))
                Notify("Error: " .. label, tostring(err), 6, "error")
            end
        end)
    end
end

------------------------------------------------------------------------
-- Drag helper (mouse and touch). Returns a state table, state.moved tells tap from drag.
------------------------------------------------------------------------

local function makeDraggable(handle, target)
    local state = { moved = false }
    local dragging, startPos, origin = false, nil, nil

    keep(handle.InputBegan:Connect(function(input)
        if not isPointer(input) then return end
        dragging = true
        state.moved = false
        startPos = input.Position
        origin = target.Position
        local conn
        conn = input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
                conn:Disconnect()
            end
        end)
    end))

    keep(UserInputService.InputChanged:Connect(function(input)
        if not dragging or not isMotion(input) then return end
        local delta = input.Position - startPos
        if delta.Magnitude > 6 then state.moved = true end
        if state.moved then
            target.Position = UDim2.new(
                origin.X.Scale, origin.X.Offset + delta.X,
                origin.Y.Scale, origin.Y.Offset + delta.Y
            )
        end
    end))

    return state
end

