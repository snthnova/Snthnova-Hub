------------------------------------------------------------------------
-- Helpers
------------------------------------------------------------------------

local function Notify(title, content, duration)
    WindUI:Notify({
        Title   = title,
        Content = content,
        Duration = duration or 3,
    })
end

local function getHouseTypes()
    local types = {}
    for k in pairs(HouseDB) do
        table.insert(types, k)
    end
    table.sort(types)
    return types
end

local function getFilesForType(houseType)
    local files = {}
    for _, path in ipairs(listfiles("Savedhouses")) do
        local content = readfile(path)
        if content ~= "" then
            if content:find("building_type") then
                local idx   = content:find("building_type") + 15
                local comma = content:find(",", idx)
                local bt    = content:sub(idx, (comma or 0) - 2)
                if bt == houseType then
                    table.insert(files, path)
                end
            end
        elseif houseType == "micro_2023" then
            table.insert(files, path)
        end
    end
    return files
end

local function teleportTo(mode, useTP, target)
    setthreadidentity(2)
    local enter = require(game:GetService("ReplicatedStorage").Fsys).load("InteriorsM").enter
    if mode == "interior" then
        getgenv().teleport = useTP
        enter(target, "", {})
    elseif mode == "house" then
        getgenv().teleport = useTP
        enter("housing", "MainDoor", { house_owner = target })
    end
    setthreadidentity(8)
end

------------------------------------------------------------------------
-- Furniture / Texture ownership checks
------------------------------------------------------------------------

local function furniturePlaced(id, props, key)
    if placedCache[key] then return true end
    for _, v in pairs(ClientData.get("house_interior").furniture) do
        if  v.id          == id
        and v.cframe.X    == props.cframe.X
        and v.cframe.Y    == props.cframe.Y
        and v.cframe.Z    == props.cframe.Z
        and v.scale       == props.scale then
            placedCache[key] = true
            return true
        end
    end
    return false
end

local function textureOwned(room, slot, id)
    if id == "tile" then return true end
    for k, tex in pairs(ClientData.get("house_interior").textures) do
        if k == room and tex[slot] == id then return true end
    end
    return false
end

------------------------------------------------------------------------
-- Buy helpers (recursive retry)
------------------------------------------------------------------------

local function buyFurniture(id, props, key)
    RouterClient.get("HousingAPI/BuyFurnitures"):InvokeServer({{
        kind       = id,
        properties = props,
    }})
    task.wait(0.05)
    if furniturePlaced(id, props, key) then
        print("[DEBUG] bought furniture: " .. id)
        return
    end
    warn("retrying furniture: " .. id)
    buyFurniture(id, props, key)
end

local function buyTexture(room, slot, id)
    RouterClient.get("HousingAPI/BuyTexture"):FireServer(room, slot, id)
    task.wait(0.05)
    if textureOwned(room, slot, id) then
        print("bought texture: " .. id)
        return
    end
    warn("retrying texture: " .. id)
    buyTexture(room, slot, id)
end

