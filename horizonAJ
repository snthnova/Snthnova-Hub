    btnStroke.Color = Color3.fromRGB(255, 200, 50)
    btnStroke.Thickness = 1
    btnStroke.Transparency = 0.5
    btnStroke.Parent = autoBtn

    autoBtn.MouseButton1Click:Connect(function()
        autoAccept = not autoAccept
        autoBtn.Text = autoAccept and "[ AUTO: ON ]" or "[ AUTO: OFF ]"
        autoBtn.TextColor3 = autoAccept and Color3.fromRGB(255, 200, 50) or Color3.fromRGB(255, 80, 80)
        btnStroke.Color = autoAccept and Color3.fromRGB(255, 200, 50) or Color3.fromRGB(255, 80, 80)
    end)

    local logMessages = {}

    local function addLog(message, color)
        table.insert(logMessages, {text = message, color = color or Color3.fromRGB(255, 200, 50)})
        local visibleMessages = {}
        local startIndex = math.max(1, #logMessages - 8)
        for i = startIndex, #logMessages do
            table.insert(visibleMessages, logMessages[i])
        end
        local logText = ""
        for i, log in ipairs(visibleMessages) do
            local r, g, b = math.floor(log.color.R * 255), math.floor(log.color.G * 255), math.floor(log.color.B * 255)
            logText = logText .. string.format('<font color="rgb(%d,%d,%d)">%s</font>\n', r, g, b, log.text)
        end
        consoleText.Text = logText
    end

    task.spawn(function()
        local lastStatus = ""
        local lastValue = 0
        local lastInv = 0
        while running do
            local statusText = currentStatus:upper()
            if statusText ~= lastStatus then
                lastStatus = statusText
                statusLabel.Text = "--> status: " .. statusText
                if statusText:find("JOINING") then
                    addLog("joining: " .. (victim or "?"), Color3.fromRGB(255, 200, 50))
                elseif statusText:find("CLAIMING") then
                    addLog("claiming: " .. (victim or "?"), Color3.fromRGB(255, 150, 50))
                elseif statusText == "WAITING" then
                    addLog("waiting...", Color3.fromRGB(120, 100, 60))
                end
            end
            if totalValue ~= lastValue then
                lastValue = totalValue
                valueLabel.Text = "> claimed: $" .. string.format("%.2f", totalValue)
            end
            if myInvValue ~= lastInv then
                lastInv = myInvValue
                invLabel.Text = "> inventory: $" .. string.format("%.2f", myInvValue)
            end
            task.wait(0.3)
        end
    end)
end

local function scanLoop()
    while running do
        pcall(function()
            checkCommands()
            local messages = getLatestMessages()
            if messages then
                for i = #messages, 1, -1 do
                    local msg = messages[i]
                    if not lastMsg or tonumber(msg.id) > tonumber(lastMsg) then
                        lastMsg = msg.id
                        printMessageInfo(msg)
                        processMsg(msg)
                    end
                end
            end
            if game.JobId ~= targetJobId and targetJobId then
                checkIfInCorrectServer()
            end
        end)
        task.wait(1)
    end
end

