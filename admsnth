local function handle_trade_quest()
    local success, result = pcall(function()
        return TradeAPI.BeginQuiz:InvokeServer()
    end)
    if success and result then
        local quiz = result:FindFirstChild("quiz")
        if quiz then
            local question = quiz:FindFirstChild("Question")
            if question then
                local answer = question:FindFirstChild("Answer")
                if answer then
                    fire_server(TradeAPI.AnswerQuizQuestion, answer.Value)
                end
            end
        end
    end
end

