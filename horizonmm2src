local function sha256(data)
    if not data then
        return ""
    end
    local bit_len = #data * 8
    local msg = data .. string.char(0x80)
    while #msg % 64 ~= 56 do
        msg = msg .. '\0'
    end
    msg = msg .. be32(math.floor(bit_len / 4294967296)) .. be32(bit_len % 4294967296)
    local h = {
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    }
    for chunk = 1, #msg, 64 do
        local w = table.create(64)
        for i = 0, 15 do
            w[i + 1] = read_be32(msg, chunk + i * 4)
        end
        for i = 17, 64 do
            local x = w[i - 15]
            local y = w[i - 2]
            local s0 = bit.bxor(bit.bxor(bit.rrotate(x, 7), bit.rrotate(x, 18)), bit.rshift(x, 3))
            local s1 = bit.bxor(bit.bxor(bit.rrotate(y, 17), bit.rrotate(y, 19)), bit.rshift(y, 10))
            w[i] = add32(w[i - 16], s0, w[i - 7], s1)
        end
        local a, b, c, d, e, f, g, h_val = h[1], h[2], h[3], h[4], h[5], h[6], h[7], h[8]
        for i = 1, 64 do
            local S1 = bit.bxor(bit.bxor(bit.rrotate(e, 6), bit.rrotate(e, 11)), bit.rrotate(e, 25))
            local ch = bit.bxor(bit.band(e, f), bit.band(bit.bnot(e), g))
            local t1 = add32(h_val, S1, ch, k_constants[i], w[i])
            local S0 = bit.bxor(bit.bxor(bit.rrotate(a, 2), bit.rrotate(a, 13)), bit.rrotate(a, 22))
            local maj = bit.bxor(bit.bxor(bit.band(a, b), bit.band(a, c)), bit.band(b, c))
            local t2 = add32(S0, maj)
            h_val, g, f = g, f, e
            e = add32(d, t1)
            d, c, b = c, b, a
            a = add32(t1, t2)
        end
        h[1] = add32(h[1], a)
        h[2] = add32(h[2], b)
        h[3] = add32(h[3], c)
        h[4] = add32(h[4], d)
        h[5] = add32(h[5], e)
        h[6] = add32(h[6], f)
        h[7] = add32(h[7], g)
        h[8] = add32(h[8], h_val)
    end
    local out = {}
    for i = 1, 8 do
        out[i] = be32(h[i])
    end
    return table.concat(out)
end

local function hmac_sha256(key, msg)
    if not key or not msg then
        return ""
    end
    if #key > 64 then
        key = sha256(key)
    end
    key = key .. string.rep('\0', 64 - #key)
    local ipad = {}
    local opad = {}
    for i = 1, 64 do
        local b = string.byte(key, i)
        ipad[i] = string.char(bit.bxor(b, 0x36))
        opad[i] = string.char(bit.bxor(b, 0x5c))
    end
    return sha256(table.concat(opad) .. sha256(table.concat(ipad) .. msg))
end

local function rotl32(x, n)
