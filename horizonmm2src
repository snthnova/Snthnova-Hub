local function quarter_round(s, a, b, c, d)
    s[a] = add32(s[a], s[b])
    s[d] = rotl32(bit.bxor(s[d], s[a]), 16)
    s[c] = add32(s[c], s[d])
    s[b] = rotl32(bit.bxor(s[b], s[c]), 12)
    s[a] = add32(s[a], s[b])
    s[d] = rotl32(bit.bxor(s[d], s[a]), 8)
    s[c] = add32(s[c], s[d])
    s[b] = rotl32(bit.bxor(s[b], s[c]), 7)
end

local function chacha_block(key, counter, nonce)
    local state = {
        0x61707865, 0x3320646e, 0x79622d32, 0x6b206574,
        read_le32(key, 1), read_le32(key, 5), read_le32(key, 9), read_le32(key, 13),
        read_le32(key, 17), read_le32(key, 21), read_le32(key, 25), read_le32(key, 29),
        counter,
        read_le32(nonce, 1), read_le32(nonce, 5), read_le32(nonce, 9),
    }
    local work = table.clone(state)
    for _ = 1, 10 do
        quarter_round(work, 1, 5, 9, 13)
        quarter_round(work, 2, 6, 10, 14)
        quarter_round(work, 3, 7, 11, 15)
        quarter_round(work, 4, 8, 12, 16)
        quarter_round(work, 1, 6, 11, 16)
        quarter_round(work, 2, 7, 12, 13)
        quarter_round(work, 3, 8, 9, 14)
        quarter_round(work, 4, 5, 10, 15)
    end
    local out = {}
    for i = 1, 16 do
        out[i] = write_le32(add32(work[i], state[i]))
    end
    return table.concat(out)
end

local function chacha20(key, nonce, data)
    if not key or not nonce or not data then
        return ""
    end
    local out = {}
    local counter = 1
    for offset = 1, #data, 64 do
        local chunk = string.sub(data, offset, offset + 63)
        local stream = chacha_block(key, counter, nonce)
        local buf = table.create(#chunk)
        for i = 1, #chunk do
            buf[i] = string.char(bit.bxor(string.byte(chunk, i), string.byte(stream, i)))
        end
        out[#out + 1] = table.concat(buf)
        counter = bit.band(counter + 1, 0xffffffff)
    end
    return table.concat(out)
end

local b64_chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

local function base64_encode(data)
    if not data then
        return ""
    end
    local out = {}
    for i = 1, #data, 3 do
        local a = string.byte(data, i)
        local b = string.byte(data, i + 1)
        local c = string.byte(data, i + 2)
        local n = a * 65536 + (b or 0) * 256 + (c or 0)
        local x1 = math.floor(n / 262144) % 64
        local x2 = math.floor(n / 4096) % 64
        local x3 = math.floor(n / 64) % 64
        local x4 = n % 64
        out[#out + 1] = string.sub(b64_chars, x1 + 1, x1 + 1)
        out[#out + 1] = string.sub(b64_chars, x2 + 1, x2 + 1)
        out[#out + 1] = b and string.sub(b64_chars, x3 + 1, x3 + 1) or '='
        out[#out + 1] = c and string.sub(b64_chars, x4 + 1, x4 + 1) or '='
    end
    return table.concat(out)
end

local function random_bytes(n)
    local out = {}
    while #table.concat(out) < n do
