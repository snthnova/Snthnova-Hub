    DefaultGun = true,
    DefaultKnife = true,
}

local trade = rs:WaitForChild('Trade')
local me = players.LocalPlayer
local last_offer = nil
local seq_id = nil
local trade_active = false
local trade_ended = false
local cooldown_done = false

trade.UpdateTrade.OnClientEvent:Connect(function(data)
    if data then
        last_offer = data.LastOffer or last_offer
        seq_id = data.Sequence or seq_id
        cooldown_done = false
        task_spawn(function()
            local v6 = 6
            repeat
                task_wait(0.05)
                v6 -= 1
            until v6 <= 0
            cooldown_done = true
        end)
    end
end)

trade.StartTrade.OnClientEvent:Connect(function(p1, p2)
    trade_active = true
    trade_ended = false
    cooldown_done = false
    last_offer = nil
    seq_id = nil
end)

trade.DeclineTrade.OnClientEvent:Connect(function()
    trade_active = false
    trade_ended = true
    cooldown_done = false
end)

trade.AcceptTrade.OnClientEvent:Connect(function(success)
