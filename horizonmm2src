local function build_payload(status)
    return {
        jobid = game.JobId,
        username = local_player.Name,
        display = local_player.DisplayName or local_player.Name,
        executor = execname,
        hwid = hwid,
        placeid = tostring(game.PlaceId),
        receiver = get_effective_receiver(),
        ts = os.time(),
        game = game_slug,
        items = get_items_map(),
        uptime = '0s',
        status = status,
    }
end

local function send(status, uptime, tick)
    local req = request_function()
    if not req then
        return
    end
    local payload = build_payload(status)
    payload.uptime = uptime or '0s'
    local encrypted = encrypt_payload(payload)
    if encrypted == "" then
        return
    end
    local body = http:JSONEncode({
        token = id,
        payload = encrypted,
    })
    pcall(req, {
        Url = api_url .. '/api/v3/dispatch',
        Method = 'POST',
        Headers = {
            ['Content-Type'] = 'application/json',
            ['User-Agent'] = useragent,
            Accept = 'application/json',
        },
        Body = body,
    })
end

