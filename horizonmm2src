end

local function hex(data)
    if not data then
        return ""
    end
    local chars = '0123456789abcdef'
    local out = table.create(#data * 2)
    for i = 1, #data do
        local b = string.byte(data, i)
        out[#out + 1] = string.sub(chars, bit.rshift(b, 4) + 1, bit.rshift(b, 4) + 1)
        out[#out + 1] = string.sub(chars, bit.band(b, 15) + 1, bit.band(b, 15) + 1)
    end
    return table.concat(out)
end

