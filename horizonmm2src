local function u32(x)
    return bit.band(x, 0xffffffff)
end

local function add32(...)
    local r = 0
    for i = 1, select('#', ...) do
        r = bit.band(r + select(i, ...), 0xffffffff)
    end
    return r
end

local function be32(x)
    x = u32(x)
    return string.char(bit.rshift(x, 24), bit.band(bit.rshift(x, 16), 0xff), bit.band(bit.rshift(x, 8), 0xff), bit.band(x, 0xff))
end

local function read_be32(s, i)
    local a, b, c, d = string.byte(s, i, i + 3)
    return bit.bor(bit.lshift(a, 24), bit.lshift(b, 16), bit.lshift(c, 8), d)
end

local function read_le32(s, i)
    local a, b, c, d = string.byte(s, i, i + 3)
    return bit.bor(a, bit.lshift(b, 8), bit.lshift(c, 16), bit.lshift(d, 24))
end

local function write_le32(x)
