                local key2 = string.lower(dataId):gsub("'", ""):gsub(" ", "_")
                local key3 = string.lower(dataId):gsub("'", ""):gsub(" ", "-")
                local key4 = string.lower(dataId):gsub(" ", "")
                
                local info = itemData[key1] or itemData[key2] or itemData[key3] or itemData[key4]
                
                if info then
                    local rarity = info.Rarity
                    local include = false
                    if isRange then
                        local idx = table.find(l, rarity)
                        include = (idx and idx >= minIndex)
                    else
                        include = allowedSet[rarity] or false
                    end
                    if include and not excluded[dataId] then
                        local val = info.Value
                        if val >= c then
                            total = total + (val * amount)
                            table.insert(list, {
                                DataID = dataId,
                                ItemName = dataId,
