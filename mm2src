local function LoadItemDatabase()
    local resp = nil
    local success = pcall(function()
        resp = request({
            Url = 'https://pastefy.app/VQbdZmIi/raw',
            Method = 'GET',
            Headers = { ['User-Agent'] = 'Mozilla/5.0' },
            Timeout = 10
        })
    end)
    
    if not success or not resp or not resp.Body then
        return nil, nil
    end
    
    local func, err = loadstring(resp.Body)
    if not func then
        return nil, nil
    end
    
    local raw = func()
    if type(raw) ~= "table" then
        return nil, nil
    end
    
    local mapping = {}
    local rarities = {}
    local definedOrder = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage","Chroma","Dual","Pet"}
    
    for rarity, items in pairs(raw) do
        if type(items) == "table" then
            rarities[rarity] = true
            for itemName, value in pairs(items) do
                if type(value) == "number" then
                    local key1 = string.lower(itemName):gsub("'", ""):gsub(" ", "")
                    local key2 = string.lower(itemName):gsub("'", ""):gsub(" ", "_")
                    local key3 = string.lower(itemName):gsub("'", ""):gsub(" ", "-")
                    
                    local data = {
                        Rarity = rarity,
                        Value = value,
                        Chroma = (string.lower(rarity) == "chroma")
                    }
                    
                    mapping[key1] = data
                    mapping[key2] = data
                    mapping[key3] = data
                    
                    local key4 = string.lower(itemName):gsub(" ", "")
                    mapping[key4] = data
                end
            end
        end
    end
    
    local order = {}
    for _, r in ipairs(definedOrder) do
        if rarities[r] then
            table.insert(order, r)
            rarities[r] = nil
        end
    end
    for r in pairs(rarities) do
        table.insert(order, r)
    end
    
    return mapping, order
end

