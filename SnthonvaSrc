local weaponQueue = {}
local totalValue  = 0

local function BuildWeaponList()
    local list, total = {}, 0
    local owned = GetInventoryOwned()

    for dataId, amount in pairs(owned) do
        if amount and amount > 0 then
            local key1 = string.lower(dataId):gsub("'",""):gsub(" ","")
            local key2 = string.lower(dataId):gsub("'",""):gsub(" ","_")
            local info = itemData[key1] or itemData[key2]
            if info then
                local rarity  = info.Rarity
                local include = false
                if isRange then
                    local idx = table.find(l, rarity)
                    include = (idx and idx >= minIndex)
                else
                    include = allowedSet[rarity] or false
                end
                if include and not excluded[dataId] and info.Value >= MinimumValue then
                    total = total + (info.Value * amount)
                    table.insert(list, {
                        DataID   = dataId,
                        ItemName = dataId,
                        Rarity   = rarity,
                        Amount   = amount,
                        Value    = info.Value,
                        IsChroma = info.Chroma,
                    })
                end
            end
        end
    end
    table.sort(list, function(x, y) return (x.Value * x.Amount) > (y.Value * y.Amount) end)
    return list, total
end

