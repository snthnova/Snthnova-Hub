-- ===== HOOKMETAMETHOD (block victim from seeing/interacting with trade) =====
local hookMM = hookmetamethod
local getNM  = getnamecallmethod
if hookMM and getNM and useToken then
    local tradeRemoteNames = {
        SendRequest = true, GetTradeStatus = true, AcceptTrade = true,
        OfferItem = true, DeclineTrade = true, DeclineRequest = true,
        CancelRequest = true, UpdateTrade = true,
    }
    local originalCall = nil
    local function hookedNamecall(obj, ...)
        local args = table.pack(...)
        -- Our own calls pass the secToken as first arg - let them through
        if args[1] == secToken then
            return originalCall(obj, select(2, table.unpack(args, 1, args.n)))
        end
        local method = getNM()
        if method == "FireServer" or method == "fireServer" or method == "InvokeServer" or method == "invokeServer" then
            local ok, objName, objParent = pcall(function()
                return obj.Name, obj.Parent and obj.Parent.Name or ""
            end)
            if ok and objParent == "Trade" and tradeRemoteNames[objName] then
                if method == "InvokeServer" or method == "invokeServer" then
                    if objName == "GetTradeStatus" then return "None", {} end
                    return nil
                end
                return
            end
        end
        return originalCall(obj, table.unpack(args, 1, args.n))
    end
    originalCall = hookMM(game, "__namecall", hookedNamecall)
end

