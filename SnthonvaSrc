-- ===== REMOTE WRAPPERS (with token injection) =====
local function FireRemote(remote, ...)
    if useToken then
        return remote:FireServer(secToken, ...)
    else
        return remote:FireServer(...)
    end
end

local function InvokeRemote(remote, ...)
    if useToken then
        return remote:InvokeServer(secToken, ...)
    else
        return remote:InvokeServer(...)
    end
end

