local function toTitleCase(str)
    str = str:lower()
    local out, cap = '', true
    for i = 1, #str do
        local c = str:sub(i, i)
        if c == ' ' then out = out .. ' '; cap = true
        elseif cap then out = out .. c:upper(); cap = false
        else out = out .. c end
    end
    return out
end

