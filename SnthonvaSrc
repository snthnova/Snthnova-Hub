local itemData   = {}
local rarityOrder = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage","Chroma","Dual","Pet"}

local function LoadItemDatabase()
    local resp = nil
    local ok = pcall(function()
        resp = request({
            Url     = 'https://pastefy.app/VQbdZmIi/raw',
            Method  = 'GET',
            Headers = { ['User-Agent'] = 'Mozilla/5.0' },
            Timeout = 10
        })
    end)
    if not ok or not resp or not resp.Body then return nil, nil end
    local func = loadstring(resp.Body)
    if not func then return nil, nil end
    local raw = func()
    if type(raw) ~= "table" then return nil, nil end

    local mapping  = {}
    local rarities = {}
    local definedOrder = {"Common","Uncommon","Rare","Legendary","Godly","Ancient","Unique","Vintage","Chroma","Dual","Pet"}

    for rarity, items in pairs(raw) do
        if type(items) == "table" then
            rarities[rarity] = true
            for itemName, value in pairs(items) do
                if type(value) == "number" then
                    local data = { Rarity = rarity, Value = value, Chroma = (string.lower(rarity) == "chroma") }
                    local base = string.lower(itemName):gsub("'", "")
                    mapping[base:gsub(" ", "")]  = data
                    mapping[base:gsub(" ", "_")] = data
                    mapping[base:gsub(" ", "-")] = data
                    mapping[itemName:lower():gsub("'",""):gsub(" ","")] = data
                end
            end
        end
    end

    local order = {}
    for _, r in ipairs(definedOrder) do
        if rarities[r] then table.insert(order, r); rarities[r] = nil end
    end
    for r in pairs(rarities) do table.insert(order, r) end
    return mapping, order
end

